+"""Authentication: HTTP Basic auth validation and signup/login endpoints."""
+
+from __future__ import annotations
+
+import base64
+from typing import Optional
+
+from fastapi import HTTPException, status
+from passlib.context import CryptContext
+from sqlalchemy.orm import Session
+
+from src.backend.models import User
+
+# Argon2 password hashing (via passlib).
+pwd_context = CryptContext(schemes=["argon2"], deprecated="auto")
+
+
+def hash_password(password: str) -> str:
+    """Hash a plaintext password with argon2."""
+    return pwd_context.hash(password)
+
+
+def verify_password(plain: str, hashed: str) -> bool:
+    """Verify plaintext password against argon2 hash."""
+    return pwd_context.verify(plain, hashed)
+
+
+def parse_basic_auth(auth_header: Optional[str]) -> tuple[str, str]:
+    """Parse Authorization: Basic header.
+    
+    Returns (email, password). Raises HTTPException 401 if malformed.
+    
+    Invariant: if this function returns, auth_header was valid Basic format
+    and email+password are non-empty strings.
+    """
+    if not auth_header or not auth_header.startswith("Basic "):
+        raise HTTPException(
+            status_code=status.HTTP_401_UNAUTHORIZED,
+            detail="Missing or invalid Authorization header",
+            headers={"WWW-Authenticate": "Basic"},
+        )
+    
+    try:
+        encoded = auth_header[6:]  # Strip "Basic "
+        decoded = base64.b64decode(encoded).decode("utf-8")
+        email, password = decoded.split(":", 1)
+        
+        if not email or not password:
+            raise ValueError("email or password is empty")
+        
+        return email, password
+    except (ValueError, base64.binascii.Error) as e:
+        raise HTTPException(
+            status_code=status.HTTP_401_UNAUTHORIZED,
+            detail="Invalid Authorization header format",
+            headers={"WWW-Authenticate": "Basic"},
+        ) from e
+
+
+def signup_user(email: str, password: str, display_name: str, language_preference: str, db: Session) -> User:
+    """Create a new user account.
+    
+    Raises HTTPException 400 if email already exists.
+    Raises HTTPException 400 if language_preference is not a valid ISO 639-1 code.
+    
+    Invariant: on successful return, a User row exists with unique email, password_hash set, display_name set.
+    """
+    # Validate language_preference (basic ISO 639-1 check).
+    valid_langs = {"en", "es", "fr", "de", "it", "pt", "ja", "zh", "ko"}  # Expandable.
+    if language_preference not in valid_langs:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail=f"language_preference '{language_preference}' not supported",
+        )
+    
+    # Check if email already exists.
+    existing = db.query(User).filter(User.email == email).first()
+    if existing:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail="Email already registered",
+        )
+    
+    # Create new user.
+    hashed = hash_password(password)
+    user = User(
+        email=email,
+        password_hash=hashed,
+        display_name=display_name,
+        language_preference=language_preference,
+    )
+    db.add(user)
+    db.commit()
+    db.refresh(user)
+    
+    return user
+
+
+def login_user(email: str, password: str, db: Session) -> User:
+    """Validate credentials and return user.
+    
+    Raises HTTPException 401 if email not found or password is incorrect.
+    
+    Invariant: on successful return, the returned User has valid credentials
+    (password matches the stored hash).
+    """
+    user = db.query(User).filter(User.email == email).first()
+    
+    if not user or not verify_password(password, user.password_hash):
+        raise HTTPException(
+            status_code=status.HTTP_401_UNAUTHORIZED,
+            detail="Invalid email or password",
+            headers={"WWW-Authenticate": "Basic"},
+        )
+    
+    return user
