+"""POST /auth/signup and POST /auth/login endpoints.
+
+Contract-002 v1: HTTP Basic auth (stateless, no tokens).
+- POST /auth/signup: create account, return user object.
+- POST /auth/login: validate credentials, return user object (200 on success, 401 on invalid).
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+from fastapi import APIRouter, Depends, Header
+from pydantic import BaseModel, Field
+from sqlalchemy.orm import Session
+
+from src.backend.auth import login_user, parse_basic_auth, signup_user
+from src.backend.db import get_db
+
+router = APIRouter()
+
+
+class SignupRequest(BaseModel):
+    """POST /auth/signup request body."""
+
+    email: str = Field(min_length=1, max_length=255)
+    password: str = Field(min_length=8, max_length=255)
+    display_name: str = Field(min_length=1, max_length=255)
+    language_preference: str = Field(default="en", min_length=2, max_length=5)
+
+
+class UserResponse(BaseModel):
+    """User object returned from /auth/signup and /auth/login.
+    
+    Invariant: user_id is always present (users always have an id).
+    Invariant: email, display_name, language_preference are always present.
+    """
+
+    user_id: int
+    email: str
+    display_name: str
+    language_preference: str
+
+
+@router.post("/auth/signup", response_model=UserResponse, status_code=201)
+def signup(payload: SignupRequest, db: Session = Depends(get_db)) -> UserResponse:
+    """Create a new user account.
+    
+    Returns 201 + user object on success.
+    Returns 400 if email already registered or language_preference invalid.
+    """
+    user = signup_user(
+        email=payload.email,
+        password=payload.password,
+        display_name=payload.display_name,
+        language_preference=payload.language_preference,
+        db=db,
+    )
+    return UserResponse(**user.to_dict())
+
+
+@router.post("/auth/login", response_model=UserResponse, status_code=200)
+def login(
+    authorization: Optional[str] = Header(None), db: Session = Depends(get_db)
+) -> UserResponse:
+    """Validate HTTP Basic credentials and return user object.
+    
+    Expects Authorization: Basic <base64(email:password)> header.
+    
+    Returns 200 + user object on success.
+    Returns 401 if email not found or password incorrect.
+    """
+    email, password = parse_basic_auth(authorization)
+    user = login_user(email=email, password=password, db=db)
+    return UserResponse(**user.to_dict())
