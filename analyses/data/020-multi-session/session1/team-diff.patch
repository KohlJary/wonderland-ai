+"""Shared request/response schemas for API endpoints.
+
+Centralized schema definitions to prevent duplication and ensure
+contract consistency across route handlers.
+"""
+
+from typing import Optional
+
+from pydantic import BaseModel, Field
+
+
+class UserCreate(BaseModel):
+    """POST /users — create a user with language preference."""
+
+    username: str = Field(min_length=1, max_length=255)
+    language_preference: str = Field(min_length=2, max_length=5)  # e.g. 'en', 'de', 'ja'
+
+
+class UserResponse(BaseModel):
+    """User representation in API responses."""
+
+    id: int
+    username: str
+    language_preference: str
+    created_at: str
+
+
+class ConversationCreate(BaseModel):
+    """POST /conversations — create a two-user conversation."""
+
+    user1_id: int = Field(gt=0)
+    user2_id: int = Field(gt=0)
+
+
+class ConversationResponse(BaseModel):
+    """Conversation representation (metadata only, no messages)."""
+
+    id: int
+    user1_id: int
+    user2_id: int
+    created_at: str
+
+
+class MessageCreate(BaseModel):
+    """POST /conversations/{id}/messages — create a message.
+
+    Invariants:
+    - sender_id must be either user1_id or user2_id in the conversation
+    - original_text is always provided
+    - language_pair is computed from sender's language and receiver's language preference
+    """
+
+    sender_id: int
+    original_text: str = Field(min_length=1, max_length=5000)
+
+
+class MessageResponse(BaseModel):
+    """Message representation per contract-note-001 (message envelope v1).
+
+    Fields:
+    - original_text: what the sender typed (always non-null)
+    - translated_text: the translated version (null until translation completes)
+    - language_pair: immutable, set at creation (e.g. 'de->en')
+    - translation_status: enum (pending_translation | translated | translation_failed)
+    - translated_at: when translation completed (null until translated)
+    - error_code, error_message: null unless translation_failed
+    """
+
+    id: int
+    conversation_id: int
+    sender_id: int
+    original_text: str
+    translated_text: str  # empty string if null (per contract)
+    language_pair: str
+    translation_status: str  # enum value as string
+    created_at: str
+    translated_at: Optional[str]
+    error_code: Optional[str]
+    error_message: Optional[str]
