--- /dev/null
+++ b/src/frontend/rate_limit.ts
@@ -0,0 +1,176 @@
+/**
+ * Rate-limit client state and UI control.
+ *
+ * Tracks rate-limit state on the client side:
+ * - Current rate-limit status (allowed | rate_limited)
+ * - Time remaining until reset (wall-clock countdown)
+ * - Queued requests to be retried after window closes
+ *
+ * Server contract:
+ * - 429 response with Retry-After header (integer seconds)
+ * - 429 response body includes "reason" field
+ * - Retry-After is wall-clock seconds until bucket resets
+ */
+
+export type RateLimitStatus = "allowed" | "rate_limited";
+
+export interface RateLimitState {
+  status: RateLimitStatus;
+  resetTime: number | null; // Unix timestamp (ms) when quota resets
+  secondsUntilReset: number; // Derived countdown for UI display
+}
+
+export interface QueuedRequest {
+  id: string;
+  payload: Record<string, unknown>;
+  timestamp: number; // When queued (ms)
+}
+
+class RateLimitClient {
+  private state: RateLimitState = {
+    status: "allowed",
+    resetTime: null,
+    secondsUntilReset: 0,
+  };
+
+  private queue: QueuedRequest[] = [];
+  private countdownInterval: NodeJS.Timeout | null = null;
+  private requestIdCounter = 0;
+
+  /**
+   * Check if a request is allowed to proceed.
+   * If rate-limited, the request is queued for retry after window closes.
+   */
+  canRequest(): boolean {
+    return this.state.status === "allowed";
+  }
+
+  /**
+   * Get current rate-limit state for UI display.
+   */
+  getState(): Readonly<RateLimitState> {
+    return Object.freeze({ ...this.state });
+  }
+
+  /**
+   * Get queued requests (for debugging / inspection).
+   */
+  getQueue(): QueuedRequest[] {
+    return [...this.queue];
+  }
+
+  /**
+   * Process a 429 response from the server.
+   *
+   * Extracts Retry-After header and sets rate-limit state.
+   * Starts countdown timer for UI.
+   */
+  handleRateLimitResponse(response: Response): void {
+    const retryAfterHeader = response.headers.get("retry-after");
+    if (!retryAfterHeader) {
+      // Malformed 429; assume 60 second default
+      this.setRateLimitWindow(60);
+      return;
+    }
+
+    const secondsUntilReset = parseInt(retryAfterHeader, 10);
+    if (Number.isNaN(secondsUntilReset) || secondsUntilReset <= 0) {
+      this.setRateLimitWindow(60);
+      return;
+    }
+
+    this.setRateLimitWindow(secondsUntilReset);
+  }
+
+  /**
+   * Queue a request to be retried after rate-limit window closes.
+   */
+  queueRequest(payload: Record<string, unknown>): string {
+    const id = `queued-${++this.requestIdCounter}`;
+    this.queue.push({
+      id,
+      payload,
+      timestamp: Date.now(),
+    });
+    return id;
+  }
+
+  /**
+   * Get the next queued request (FIFO).
+   */
+  dequeueRequest(): QueuedRequest | undefined {
+    return this.queue.shift();
+  }
+
+  /**
+   * Clear all queued requests.
+   */
+  clearQueue(): void {
+    this.queue = [];
+  }
+
+  /**
+   * Notify listeners when rate-limit status changes.
+   * (For reactive UI frameworks, emit events here.)
+   */
+  private onStatusChange(newStatus: RateLimitStatus): void {
+    // Hook for listeners (React state, Vue reactivity, etc.)
+    // Implement via observer pattern or event emitter in the actual UI layer
+    if (typeof window !== "undefined" && (window as any).__rateLimitStatusChange) {
+      (window as any).__rateLimitStatusChange(newStatus, this.state);
+    }
+  }
+
+  /**
+   * Set rate-limit window: start countdown, mark as rate-limited.
+   */
+  private setRateLimitWindow(secondsUntilReset: number): void {
+    this.state.status = "rate_limited";
+    this.state.resetTime = Date.now() + secondsUntilReset * 1000;
+    this.state.secondsUntilReset = secondsUntilReset;
+
+    this.onStatusChange("rate_limited");
+
+    // Start countdown timer
+    this.startCountdown();
+  }
+
+  /**
+   * Start countdown timer that updates state.secondsUntilReset every second.
+   */
+  private startCountdown(): void {
+    // Clear any existing countdown
+    if (this.countdownInterval) {
+      clearInterval(this.countdownInterval);
+    }
+
+    // Update countdown every second
+    this.countdownInterval = setInterval(() => {
+      if (!this.state.resetTime) {
+        clearInterval(this.countdownInterval!);
+        this.countdownInterval = null;
+        return;
+      }
+
+      const now = Date.now();
+      const remaining = this.state.resetTime - now;
+
+      if (remaining <= 0) {
+        // Window closed; reset state
+        this.state.status = "allowed";
+        this.state.resetTime = null;
+        this.state.secondsUntilReset = 0;
+        clearInterval(this.countdownInterval!);
+        this.countdownInterval = null;
+
+        this.onStatusChange("allowed");
+      } else {
+        // Update countdown
+        this.state.secondsUntilReset = Math.ceil(remaining / 1000);
+      }
+    }, 1000);
+  }
+}
+
+// Export singleton instance for use across the app
+export const rateLimitClient = new RateLimitClient();
