+/**
+ * Frontend rate-limit client tests.
+ *
+ * These tests verify the client-side rate-limit state machine,
+ * queue behavior, and countdown logic.
+ *
+ * Note: These are unit tests. Integration tests (testing the full
+ * flow with backend responses) are in the parent test suite.
+ */
+
+import { rateLimitClient, RateLimitState } from "../rate_limit";
+
+describe("RateLimitClient", () => {
+  beforeEach(() => {
+    // Reset client state before each test
+    rateLimitClient.clearQueue();
+  });
+
+  describe("canRequest", () => {
+    test("returns true initially", () => {
+      expect(rateLimitClient.canRequest()).toBe(true);
+    });
+
+    test("returns false after rate limit is set", () => {
+      rateLimitClient.handleRateLimitResponse(
+        new Response(null, { status: 429, headers: { "retry-after": "60" } })
+      );
+      expect(rateLimitClient.canRequest()).toBe(false);
+    });
+  });
+
+  describe("getState", () => {
+    test("returns initial state: allowed, no reset time", () => {
+      const state = rateLimitClient.getState();
+      expect(state.status).toBe("allowed");
+      expect(state.resetTime).toBeNull();
+      expect(state.secondsUntilReset).toBe(0);
+    });
+
+    test("returns rate_limited state after 429 response", () => {
+      const response = new Response(null, {
+        status: 429,
+        headers: { "retry-after": "30" },
+      });
+      rateLimitClient.handleRateLimitResponse(response);
+
+      const state = rateLimitClient.getState();
+      expect(state.status).toBe("rate_limited");
+      expect(state.resetTime).not.toBeNull();
+      expect(state.secondsUntilReset).toBeGreaterThan(0);
+      expect(state.secondsUntilReset).toBeLessThanOrEqual(30);
+    });
+
+    test("returns frozen copy (immutable)", () => {
+      const state = rateLimitClient.getState();
+      expect(() => {
+        (state as any).status = "changed";
+      }).toThrow();
+    });
+  });
+
+  describe("handleRateLimitResponse", () => {
+    test("parses Retry-After header and sets countdown", () => {
+      const response = new Response(null, {
+        status: 429,
+        headers: { "retry-after": "45" },
+      });
+      rateLimitClient.handleRateLimitResponse(response);
+
+      const state = rateLimitClient.getState();
+      expect(state.status).toBe("rate_limited");
+      expect(state.secondsUntilReset).toBeGreaterThan(0);
+      expect(state.secondsUntilReset).toBeLessThanOrEqual(45);
+    });
+
+    test("defaults to 60 seconds if Retry-After is missing", () => {
+      const response = new Response(null, { status: 429 });
+      rateLimitClient.handleRateLimitResponse(response);
+
+      const state = rateLimitClient.getState();
+      expect(state.secondsUntilReset).toBeGreaterThan(0);
+      expect(state.secondsUntilReset).toBeLessThanOrEqual(60);
+    });
+
+    test("defaults to 60 seconds if Retry-After is malformed", () => {
+      const response = new Response(null, {
+        status: 429,
+        headers: { "retry-after": "not-a-number" },
+      });
+      rateLimitClient.handleRateLimitResponse(response);
+
+      const state = rateLimitClient.getState();
+      expect(state.secondsUntilReset).toBeGreaterThan(0);
+    });
+  });
+
+  describe("queueRequest", () => {
+    test("adds request to queue and returns ID", () => {
+      const id = rateLimitClient.queueRequest({ text: "hello" });
+      expect(id).toBeTruthy();
+      expect(id).toMatch(/^queued-\d+$/);
+
+      const queue = rateLimitClient.getQueue();
+      expect(queue).toHaveLength(1);
+      expect(queue[0].id).toBe(id);
+      expect(queue[0].payload).toEqual({ text: "hello" });
+    });
+
+    test("queues multiple requests in FIFO order", () => {
+      const id1 = rateLimitClient.queueRequest({ text: "first" });
+      const id2 = rateLimitClient.queueRequest({ text: "second" });
+      const id3 = rateLimitClient.queueRequest({ text: "third" });
+
+      const queue = rateLimitClient.getQueue();
+      expect(queue).toHaveLength(3);
+      expect(queue[0].payload.text).toBe("first");
+      expect(queue[1].payload.text).toBe("second");
+      expect(queue[2].payload.text).toBe("third");
+    });
+  });
+
+  describe("dequeueRequest", () => {
+    test("returns undefined if queue is empty", () => {
+      expect(rateLimitClient.dequeueRequest()).toBeUndefined();
+    });
+
+    test("returns and removes first queued request (FIFO)", () => {
+      rateLimitClient.queueRequest({ text: "first" });
+      rateLimitClient.queueRequest({ text: "second" });
+
+      const dequeued = rateLimitClient.dequeueRequest();
+      expect(dequeued).toBeDefined();
+      expect(dequeued?.payload.text).toBe("first");
+
+      const queue = rateLimitClient.getQueue();
+      expect(queue).toHaveLength(1);
+      expect(queue[0].payload.text).toBe("second");
+    });
+  });
+
+  describe("clearQueue", () => {
+    test("removes all queued requests", () => {
+      rateLimitClient.queueRequest({ text: "a" });
+      rateLimitClient.queueRequest({ text: "b" });
+      expect(rateLimitClient.getQueue()).toHaveLength(2);
+
+      rateLimitClient.clearQueue();
+      expect(rateLimitClient.getQueue()).toHaveLength(0);
+    });
+  });
+
+  describe("countdown behavior", () => {
+    test("countdown decrements secondsUntilReset every second", (done) => {
+      jest.useFakeTimers();
+
+      const response = new Response(null, {
+        status: 429,
+        headers: { "retry-after": "5" },
+      });
+      rateLimitClient.handleRateLimitResponse(response);
+
+      const state1 = rateLimitClient.getState();
+      const initial = state1.secondsUntilReset;
+
+      jest.advanceTimersByTime(1000);
+      const state2 = rateLimitClient.getState();
+
+      // secondsUntilReset should have decreased
+      expect(state2.secondsUntilReset).toBeLessThan(initial);
+
+      jest.useRealTimers();
+      done();
+    });
+
+    test("resets status to allowed when countdown reaches zero", (done) => {
+      jest.useFakeTimers();
+
+      const response = new Response(null, {
+        status: 429,
+        headers: { "retry-after": "1" },
+      });
+      rateLimitClient.handleRateLimitResponse(response);
+
+      expect(rateLimitClient.getState().status).toBe("rate_limited");
+
+      // Advance time past the reset window
+      jest.advanceTimersByTime(1500);
+
+      expect(rateLimitClient.getState().status).toBe("allowed");
+      expect(rateLimitClient.getState().resetTime).toBeNull();
+
+      jest.useRealTimers();
+      done();
+    });
+  });
+
+  describe("integration: queue + countdown", () => {
+    test("queued requests remain in queue while rate-limited", () => {
+      const response = new Response(null, {
+        status: 429,
+        headers: { "retry-after": "60" },
+      });
+      rateLimitClient.handleRateLimitResponse(response);
+
+      rateLimitClient.queueRequest({ text: "msg1" });
+      rateLimitClient.queueRequest({ text: "msg2" });
+
+      expect(rateLimitClient.getState().status).toBe("rate_limited");
+      expect(rateLimitClient.getQueue()).toHaveLength(2);
+    });
+
+    test("queue can be drained manually", () => {
+      const response = new Response(null, {
+        status: 429,
+        headers: { "retry-after": "60" },
+      });
+      rateLimitClient.handleRateLimitResponse(response);
+
+      rateLimitClient.queueRequest({ text: "msg1" });
+      rateLimitClient.queueRequest({ text: "msg2" });
+
+      const dequeued: any[] = [];
+      let req = rateLimitClient.dequeueRequest();
+      while (req) {
+        dequeued.push(req);
+        req = rateLimitClient.dequeueRequest();
+      }
+
+      expect(dequeued).toHaveLength(2);
+      expect(rateLimitClient.getQueue()).toHaveLength(0);
+    });
+  });
+});
