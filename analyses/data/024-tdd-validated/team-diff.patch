+                "/api/messages",
+                json={"text": f"user1-{i}"},
+                headers={"User-ID": "user-1"},
+            )
+            assert res.status_code == 200
+
+        # Metrics should show separate buckets for different user_ids
+        # (Property check: the metrics system supports labeling)
+
+    def test_metrics_include_endpoint_labels(self, client):
+        """Metrics distinguish between different endpoints."""
+        # /api/messages quota is independent from (future) /api/comments quota
+        for i in range(5):
+            client.post("/api/messages", json={"text": f"msg-{i}"})
+
+        # Future: test /api/comments if it exists
+        # Metrics should label by endpoint
+
+    def test_bucket_usage_gauge_reflects_current_state(self, client):
+        """rate_limit_bucket_usage gauge shows current request count."""
+        # After 5 requests, gauge should show 5
+        for i in range(5):
+            client.post("/api/messages", json={"text": f"msg {i}"})
+
+        # Metrics should show rate_limit_bucket_usage = 5 (or similar)
+        # After 10 more minutes, gauge should reset to 0
