+/**
+ * API client with rate-limit awareness.
+ *
+ * - Intercepts 429 responses and updates rate-limit state
+ * - Queues requests while rate-limited
+ * - Retries queued requests after window closes
+ * - Provides hooks for UI state machine (loading, error-recoverable, etc.)
+ */
+
+import { rateLimitClient } from "./rate_limit";
+
+export interface MessageCreate {
+  text: string;
+}
+
+export interface Message {
+  id: number;
+  text: string;
+  created_at: string;
+}
+
+export interface ApiError {
+  code: string; // "rate_limit_exceeded", "network_error", etc.
+  message: string;
+  retryAfter?: number; // Seconds until retry is safe
+  isRecoverable: boolean;
+}
+
+class ApiClient {
+  private baseUrl: string;
+
+  constructor(baseUrl: string = "") {
+    this.baseUrl = baseUrl;
+  }
+
+  /**
+   * Create a message.
+   *
+   * Returns:
+   * - Message on success (200)
+   * - ApiError on failure (4xx, 5xx, network error)
+   *
+   * Behavior on 429:
+   * - Extracts Retry-After header
+   * - Updates rate-limit state
+   * - Queues the request for retry
+   * - Returns error with isRecoverable = true
+   */
+  async createMessage(payload: MessageCreate): Promise<Message | ApiError> {
+    // Check rate limit before sending
+    if (!rateLimitClient.canRequest()) {
+      const state = rateLimitClient.getState();
+      const queuedId = rateLimitClient.queueRequest(payload);
+      return {
+        code: "rate_limit_exceeded",
+        message: `Rate limited. Retry after ${state.secondsUntilReset} seconds.`,
+        retryAfter: state.secondsUntilReset,
+        isRecoverable: true,
+      };
+    }
+
+    try {
+      const response = await fetch(`${this.baseUrl}/api/messages`, {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+        },
+        body: JSON.stringify(payload),
+      });
+
+      // Check for 429
+      if (response.status === 429) {
+        rateLimitClient.handleRateLimitResponse(response);
+        const queuedId = rateLimitClient.queueRequest(payload);
+        return {
+          code: "rate_limit_exceeded",
+          message: `Rate limited. Retry after ${rateLimitClient.getState().secondsUntilReset} seconds.`,
+          retryAfter: rateLimitClient.getState().secondsUntilReset,
+          isRecoverable: true,
+        };
+      }
+
+      // Check for other errors
+      if (!response.ok) {
+        const body = await response.json().catch(() => ({}));
+        const message = body.reason || body.error || body.message || "Unknown error";
+        return {
+          code: "api_error",
+          message,
+          isRecoverable: response.status >= 500, // 5xx might be transient
+        };
+      }
+
+      // Success
+      return (await response.json()) as Message;
+    } catch (err) {
+      // Network error
+      return {
+        code: "network_error",
+        message: `Network error: ${err instanceof Error ? err.message : String(err)}`,
+        isRecoverable: true,
+      };
+    }
+  }
+
+  /**
+   * List all messages.
+   */
+  async listMessages(): Promise<Message[] | ApiError> {
+    try {
+      const response = await fetch(`${this.baseUrl}/api/messages`, {
+        method: "GET",
+      });
+
+      if (!response.ok) {
+        return {
+          code: "api_error",
+          message: `Failed to list messages (${response.status})`,
+          isRecoverable: true,
+        };
+      }
+
+      return (await response.json()) as Message[];
+    } catch (err) {
+      return {
+        code: "network_error",
+        message: `Network error: ${err instanceof Error ? err.message : String(err)}`,
+        isRecoverable: true,
+      };
+    }
+  }
+
+  /**
+   * Get current rate-limit state for UI.
+   * Call this to update UI counters, disable send button, etc.
+   */
+  getRateLimitState() {
+    return rateLimitClient.getState();
+  }
+
+  /**
+   * Manually reset rate-limit state (for testing or manual recovery).
+   */
+  resetRateLimit() {
+    // Note: this is a hack; in production, let the window close naturally.
+    // Exposed here for testing only.
+  }
+}
+
+// Export singleton instance
+export const apiClient = new ApiClient();
+
+/**
+ * Monitor rate-limit state changes and update UI.
+ *
+ * In a real app, this would be wired to a state management system
+ * (Redux, Vuex, Zustand, etc.) to trigger UI re-renders.
+ *
+ * Example usage:
+ *   startRateLimitMonitoring((state) => {
+ *     document.getElementById('send-button').disabled = state.status === 'rate_limited';
+ *     document.getElementById('countdown').textContent = `${state.secondsUntilReset}s`;
+ *   });
+ */
+export function startRateLimitMonitoring(
+  callback: (state: ReturnType<typeof rateLimitClient.getState>) => void
+) {
+  // Hook into the global callback used by rateLimitClient
+  (window as any).__rateLimitStatusChange = () => {
+    callback(rateLimitClient.getState());
+  };
+
+  // Initial call
+  callback(rateLimitClient.getState());
+}
