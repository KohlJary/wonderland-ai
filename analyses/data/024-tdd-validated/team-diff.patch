+/**
+ * RateLimitError component — displays recoverable rate-limit error.
+ *
+ * UI States:
+ * - Visible countdown: "You've sent too many messages. Please wait 47 seconds."
+ * - Disabled send button while countdown active
+ * - Clear error message distinguishing from network/auth errors
+ *
+ * Props:
+ * - secondsUntilReset: countdown in seconds (from rateLimitClient.getState())
+ * - onRetry: callback when user clicks retry (called by parent when window closes)
+ */
+
+import React, { useEffect, useState } from "react";
+
+interface RateLimitErrorProps {
+  secondsUntilReset: number;
+  onRetry?: () => void;
+}
+
+export const RateLimitError: React.FC<RateLimitErrorProps> = ({
+  secondsUntilReset,
+  onRetry,
+}) => {
+  const [displaySeconds, setDisplaySeconds] = useState(secondsUntilReset);
+
+  useEffect(() => {
+    setDisplaySeconds(secondsUntilReset);
+
+    // If countdown reached zero, trigger retry
+    if (secondsUntilReset <= 0 && onRetry) {
+      onRetry();
+    }
+  }, [secondsUntilReset, onRetry]);
+
+  return (
+    <div
+      className="rate-limit-error"
+      role="alert"
+      aria-live="polite"
+      aria-atomic="true"
+    >
+      <h3 className="rate-limit-error-title">Rate limit exceeded</h3>
+      <p className="rate-limit-error-message">
+        You've sent too many messages. Please wait{" "}
+        <span className="countdown">{displaySeconds}</span> second
+        {displaySeconds === 1 ? "" : "s"}.
+      </p>
+      <p className="rate-limit-error-help">
+        Try sending again in a moment.
+      </p>
+
+      <style>{`
+        .rate-limit-error {
+          padding: 16px;
+          background-color: #fff3cd;
+          border: 1px solid #ffc107;
+          border-radius: 4px;
+          color: #856404;
+          margin-bottom: 16px;
+        }
+
+        .rate-limit-error-title {
+          margin-top: 0;
+          margin-bottom: 8px;
+          font-size: 18px;
+          font-weight: 600;
+        }
+
+        .rate-limit-error-message {
+          margin: 0 0 8px 0;
+          font-size: 14px;
+        }
+
+        .countdown {
+          font-weight: 600;
+          font-family: monospace;
+        }
+
+        .rate-limit-error-help {
+          margin: 0;
+          font-size: 12px;
+          opacity: 0.8;
+        }
+      `}</style>
+    </div>
+  );
+};
+
+export default RateLimitError;
