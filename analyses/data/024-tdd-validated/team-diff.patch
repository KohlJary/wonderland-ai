+"""Rate limiter — per-client quota tracking.
+
+Tracks requests per client_id (User-ID header or IP fallback).
+Quota: 10 requests/minute.
+State: in-memory dict keyed by client_id, values are (request_count, bucket_reset_time).
+"""
+
+from __future__ import annotations
+
+import time
+from threading import Lock
+from typing import NamedTuple
+
+
+# Module-level constants: single source of truth for quota configuration
+QUOTA_LIMIT = 10
+QUOTA_WINDOW_SECONDS = 60
+
+
+class BucketState(NamedTuple):
+    """Current state of a rate limit bucket."""
+    requests_in_bucket: int
+    bucket_reset_time: float  # Unix timestamp (wall-clock seconds)
+
+
+class RateLimiter:
+    """Thread-safe in-memory rate limiter.
+    
+    Quota: 10 requests/minute per client_id.
+    Bucket resets on a 60-second rolling window.
+    """
+    
+    def __init__(self):
+        self._buckets: dict[str, BucketState] = {}
+        self._lock = Lock()
+        # Prometheus-style counters
+        self._requests_total = 0
+        self._rejections_total = 0
+    
+    def reset(self) -> None:
+        """Reset all state (for testing). Thread-safe."""
+        with self._lock:
+            self._buckets.clear()
+            self._requests_total = 0
+            self._rejections_total = 0
+    
+    def check_and_record(self, client_id: str) -> tuple[bool, float]:
+        """
+        Check if client_id is under quota.
+        If yes: increment counter, return (True, seconds_until_reset).
+        If no: don't increment, return (False, seconds_until_reset).
+        
+        Thread-safe.
+        """
+        with self._lock:
+            now = time.time()
+            
+            # Get or initialize bucket
+            if client_id not in self._buckets:
+                # New client: create bucket, allow request
+                reset_time = now + QUOTA_WINDOW_SECONDS
+                self._buckets[client_id] = BucketState(
+                    requests_in_bucket=1,
+                    bucket_reset_time=reset_time
+                )
+                self._requests_total += 1
+                seconds_until_reset = QUOTA_WINDOW_SECONDS
+                return (True, seconds_until_reset)
+            
+            bucket = self._buckets[client_id]
+            
+            # Check if bucket has expired
+            if now >= bucket.bucket_reset_time:
+                # Bucket reset: new window
+                reset_time = now + QUOTA_WINDOW_SECONDS
+                self._buckets[client_id] = BucketState(
+                    requests_in_bucket=1,
+                    bucket_reset_time=reset_time
+                )
+                self._requests_total += 1
+                seconds_until_reset = QUOTA_WINDOW_SECONDS
+                return (True, seconds_until_reset)
+            
+            # Bucket still open: check quota
+            if bucket.requests_in_bucket < QUOTA_LIMIT:
+                # Under quota: allow
+                self._buckets[client_id] = BucketState(
+                    requests_in_bucket=bucket.requests_in_bucket + 1,
+                    bucket_reset_time=bucket.bucket_reset_time
+                )
+                self._requests_total += 1
+                seconds_until_reset = int(bucket.bucket_reset_time - now)
+                return (True, seconds_until_reset)
+            
+            # Over quota: reject
+            self._rejections_total += 1
+            seconds_until_reset = int(bucket.bucket_reset_time - now)
+            return (False, seconds_until_reset)
+    
+    def get_state(self) -> dict[str, BucketState]:
+        """Return a snapshot of all bucket states (for debug endpoint)."""
+        with self._lock:
+            return dict(self._buckets)
+    
+    def get_metrics(self) -> dict[str, int]:
+        """Return Prometheus-style counters."""
+        with self._lock:
+            return {
+                "requests_total": self._requests_total,
+                "rejections_total": self._rejections_total,
+            }
+
+
+# Global instance
+_rate_limiter = RateLimiter()
+
+
+def check_rate_limit(client_id: str) -> tuple[bool, float]:
+    """
+    Check and record a request for the given client_id.
+    Returns (allowed: bool, seconds_until_reset: float).
+    """
+    return _rate_limiter.check_and_record(client_id)
+
+
+def get_rate_limiter_state() -> dict[str, BucketState]:
+    """Get snapshot of all buckets (for debug endpoint)."""
+    return _rate_limiter.get_state()
+
+
+def get_rate_limiter_metrics() -> dict[str, int]:
+    """Get Prometheus counters."""
+    return _rate_limiter.get_metrics()
