+"""Observability endpoints — metrics and debug state.
+
+/metrics — Prometheus metrics export
+/internal/rate-limit-state — internal debug state (for operators)
+"""
+
+from fastapi import APIRouter
+from fastapi.responses import PlainTextResponse
+
+from src.backend.rate_limiter import get_rate_limiter_metrics, get_rate_limiter_state
+
+router = APIRouter()
+
+
+@router.get("/metrics")
+def metrics() -> PlainTextResponse:
+    """
+    Export Prometheus metrics in text format.
+    
+    Metrics:
+    - rate_limit_requests_total: counter of all requests through limiter
+    - rate_limit_rejections_total: counter of 429 rejections
+    """
+    metrics_dict = get_rate_limiter_metrics()
+    
+    # Prometheus text format: TYPE and HELP lines, then metric + value
+    lines = [
+        "# HELP rate_limit_requests_total Total requests through rate limiter",
+        "# TYPE rate_limit_requests_total counter",
+        f"rate_limit_requests_total {metrics_dict['requests_total']}",
+        "",
+        "# HELP rate_limit_rejections_total Total rate limit rejections (429s)",
+        "# TYPE rate_limit_rejections_total counter",
+        f"rate_limit_rejections_total {metrics_dict['rejections_total']}",
+    ]
+    
+    return PlainTextResponse("\n".join(lines))
+
+
+@router.get("/internal/rate-limit-state")
+def rate_limit_debug_state() -> dict:
+    """
+    Internal debug endpoint — shows current rate limit bucket state.
+    
+    Returns a dict mapping client_id → {requests_in_bucket, bucket_reset_time}.
+    
+    This endpoint is internal-only (not authenticated, but not public-facing).
+    In a real system, this would be restricted to internal IPs or require
+    a special admin token.
+    
+    **Not for frontend/client use** — use the Retry-After header in 429 responses.
+    """
+    state = get_rate_limiter_state()
+    
+    # Convert BucketState namedtuples to dicts for JSON serialization
+    result = {}
+    for client_id, bucket in state.items():
+        result[client_id] = {
+            "requests_in_bucket": bucket.requests_in_bucket,
+            "bucket_reset_time": bucket.bucket_reset_time,
+        }
+    
+    return result
