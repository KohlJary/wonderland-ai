+"""Password hashing and authentication utilities (Ruling 005).
+
+Per OWASP A02:2021 (Cryptographic Failures), all passwords are hashed with
+bcrypt(rounds=12) before storage. This module provides the hashing and
+verification functions that the application uses."""
+
+from passlib.context import CryptContext
+
+# bcrypt context with 12 rounds of hashing (default Passlib value)
+# Per Ruling 005: all passwords must use bcrypt, never plaintext storage
+pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto", bcrypt__rounds=12)
+
+
+def hash_password(plaintext: str) -> str:
+    """Hash a plaintext password using bcrypt(rounds=12).
+    
+    Args:
+        plaintext: the user's password (never stored)
+    
+    Returns:
+        bcrypt-hashed string, safe to store in password_hash column
+    
+    Per Ruling 005: all password writes must use this function."""
+    return pwd_context.hash(plaintext)
+
+
+def verify_password(plaintext: str, hashed: str) -> bool:
+    """Verify a plaintext password against a bcrypt hash.
+    
+    Args:
+        plaintext: the user's input password
+        hashed: the stored password_hash from the User table
+    
+    Returns:
+        True if the password matches, False otherwise
+    
+    Per Ruling 005: authentication must use this function."""
+    return pwd_context.verify(plaintext, hashed)
