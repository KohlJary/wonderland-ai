+"""Translation service client. Abstraction layer for external translation vendor
+(Google Translate, DeepL, etc.). For MVP, this is a stub that can be
+extended with real vendor implementations.
+
+Contract: synchronous call, <300ms timeout, returns either (success, translated_text)
+or (error, error_detail_for_logging). Frontend-facing error message is generic;
+error_detail is logged for debugging."""
+
+from __future__ import annotations
+
+import logging
+from typing import TypeAlias
+
+logger = logging.getLogger(__name__)
+
+# Type aliases for clarity
+TranslationResult: TypeAlias = tuple[bool, str]  # (success, translated_text or error_detail)
+
+
+class TranslationServiceError(Exception):
+    """Base exception for translation service failures."""
+
+    pass
+
+
+class TranslationTimeoutError(TranslationServiceError):
+    """Translation vendor timed out."""
+
+    pass
+
+
+class TranslationAuthError(TranslationServiceError):
+    """Translation vendor auth failed (invalid key, etc.)."""
+
+    pass
+
+
+class TranslationServiceClient:
+    """Client for external translation vendor. Implements retry logic and
+    error handling per the contract-note-006 agreement:
+      - Synchronous call
+      - Timeout <300ms
+      - One retry on transient error
+      - Permanent errors -> error_original_returned
+    """
+
+    def __init__(self, vendor_key: str | None = None):
+        """Initialize translation client. vendor_key is the API key for the
+        translation vendor (e.g., Google Translate key). For MVP testing,
+        can be None (stub mode)."""
+        self.vendor_key = vendor_key
+        self.timeout_ms = 300
+
+    def translate(self, text: str, source_lang: str, target_lang: str) -> TranslationResult:
+        """Translate text from source_lang to target_lang.
+
+        Args:
+            text: text to translate (just the current message, not history)
+            source_lang: BCP-47 language code (e.g., 'en', 'de', 'ja')
+            target_lang: BCP-47 language code
+
+        Returns:
+            (True, translated_text) on success
+            (False, error_detail) on failure (error_detail is for logging, not user display)
+
+        Contract:
+            - Always returns within 300ms (or raises TranslationTimeoutError after retry)
+            - On transient error (timeout, rate limit), retries once then returns error
+            - On permanent error (auth failure, invalid key), returns error immediately
+            - Frontend-facing error message is generic; error_detail is implementation detail
+        """
+        if source_lang == target_lang:
+            # No translation needed; return original as "translation"
+            return (True, text)
+
+        try:
+            # For MVP, stub implementation: just return the text with a language tag
+            # Real implementation would call Google Translate / DeepL API here
+            translated = self._call_vendor(text, source_lang, target_lang)
+            return (True, translated)
+        except TranslationTimeoutError as e:
+            # Transient error: retry once
+            logger.warning(
+                f"Translation timeout (attempt 1): {source_lang}->{target_lang}, retrying. "
+                f"Error: {e}"
+            )
+            try:
+                translated = self._call_vendor(text, source_lang, target_lang)
+                logger.info(f"Translation retry succeeded: {source_lang}->{target_lang}")
+                return (True, translated)
+            except TranslationTimeoutError as e_retry:
+                logger.error(
+                    f"Translation timeout (attempt 2, final): {source_lang}->{target_lang}. "
+                    f"Error: {e_retry}. Returning original."
+                )
+                return (False, f"Translation service timeout after retry: {e_retry}")
+        except TranslationAuthError as e:
+            # Permanent error: don't retry
+            logger.error(f"Translation auth error: {e}. Returning original.")
+            return (False, f"Translation service auth error: {e}")
+        except TranslationServiceError as e:
+            # Other permanent errors
+            logger.error(f"Translation service error: {e}. Returning original.")
+            return (False, f"Translation service error: {e}")
+
+    def _call_vendor(self, text: str, source_lang: str, target_lang: str) -> str:
+        """Internal: call the actual translation vendor.
+
+        For MVP (stub mode), this returns a placeholder translation with language tags.
+        Real implementation would call Google Translate API, DeepL, etc.
+
+        Raises TranslationTimeoutError, TranslationAuthError, TranslationServiceError
+        on vendor errors."""
+        if not self.vendor_key:
+            # Stub mode: return text with language tag
+            # This allows testing the translation flow without a real vendor
+            return f"[{target_lang}] {text}"
+
+        # TODO: Real vendor integration here
+        # Example (pseudocode):
+        #   response = requests.post(
+        #       f"{VENDOR_URL}/translate",
+        #       json={"text": text, "source": source_lang, "target": target_lang},
+        #       headers={"Authorization": f"Bearer {self.vendor_key}"},
+        #       timeout=0.3  # 300ms
+        #   )
+        #   if response.status_code == 401:
+        #       raise TranslationAuthError(response.text)
+        #   elif response.status_code == 429:
+        #       raise TranslationTimeoutError("Rate limited")
+        #   elif response.status_code == 200:
+        #       return response.json()["translatedText"]
+        #   else:
+        #       raise TranslationServiceError(f"HTTP {response.status_code}")
+
+        return f"[{target_lang}] {text}"
+
+
+# Singleton instance (initialized in main.py with vendor_key from env)
+_client: TranslationServiceClient | None = None
+
+
+def init_translation_service(vendor_key: str | None = None) -> None:
+    """Initialize the translation service singleton."""
+    global _client
