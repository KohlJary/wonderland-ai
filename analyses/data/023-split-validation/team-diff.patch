+    Contract (contract-note-002, contract-note-004, contract-note-006):
+      - Accepts query param ?read_language=lang_code (required)
+      - Returns array of messages with both text_original and text_translated
+      - On translation success: text_translated is populated, translation_status='success'
+      - On translation error: text_translated is null, translation_status='error',
+        translation_error has user-facing message (generic, not implementation detail)
+      - Filters soft-deleted messages (WHERE deleted_at IS NULL)
+      - No conversation history sent to translator (just current message)
+
+    Failure modes handled (contract-note-003):
+      - Vendor timeout: returns original text + error_original_returned status
+      - Vendor auth failure: returns original text + error_original_returned status
+      - Vendor unavailable: returns original text + error_original_returned status
+      - No retries on client side (backend retried once)
+
+    Performance:
+      - Uses joinedload(Message.sender) to avoid N+1 query; sender is eager-loaded
+        with messages in a single query.
+    """
+    # Fetch conversation
+    conversation = _get_conversation_or_404(conversation_id, db)
+
+    # Validate read_language is one of the two languages in the pair
+    if not conversation.is_language_in_pair(read_language):
+        raise HTTPException(
+            status_code=400,
+            detail=f"read_language '{read_language}' not in conversation language_pair "
+            f"{conversation.get_languages()}",
+        )
+
+    # Fetch messages with sender eager-loaded (no N+1 query)
+    # joinedload(Message.sender) causes SQLAlchemy to join the User table and
+    # load all senders in a single query, rather than issuing a query per message.
+    messages = (
+        db.query(Message)
+        .options(joinedload(Message.sender))
+        .filter(
+            Message.conversation_id == conversation_id,
+            Message.deleted_at.is_(None),
+        )
+        .order_by(Message.created_at)
+        .all()
+    )
+
+    # Translate each message (if needed) and build response
+    translation_service = get_translation_service()
+    responses: list[MessageResponse] = []
+
+    for msg in messages:
+        # sender is already loaded via joinedload; no query issued here
+        sender = msg.sender
+        assert sender is not None, "Message.sender should be loaded via joinedload"
+
+        # created_at is guaranteed by database schema
+        assert msg.created_at is not None, "Message created_at should be set by database"
+
+        # Log the read operation
+        _log_audit(
+            db,
+            user_id=None,  # read operation doesn't have an authenticated requester in stub auth
+            action="message_read",
+            resource_type="message",
+            resource_id=msg.id,
+            status="success",
+            metadata={"conversation_id": conversation_id, "read_language": read_language},
+        )
+
+        # If message is already in the read language, no translation needed
+        if msg.text_language == read_language:
+            responses.append(
+                MessageResponse(
+                    id=msg.id,
+                    conversation_id=msg.conversation_id,
+                    sender_id=msg.sender_id,
+                    sender_name=sender.username,
+                    text_original=msg.text_original,
+                    text_language=msg.text_language,
+                    text_translated=msg.text_original,  # Same as original
+                    translation_status="success",
+                    translation_error=None,
+                    created_at=msg.created_at.isoformat(),
+                )
+            )
+        else:
+            # Translate message from text_language to read_language
+            success, result = translation_service.translate(
+                text=msg.text_original,
+                source_lang=msg.text_language,
+                target_lang=read_language,
+            )
 
+            if success:
+                # Translation succeeded
+                _log_audit(
+                    db,
+                    user_id=None,
+                    action="translation_request",
+                    resource_type="message",
+                    resource_id=msg.id,
+                    status="success",
+                    metadata={
+                        "source_lang": msg.text_language,
+                        "target_lang": read_language,
+                    },
+                )
+                responses.append(
+                    MessageResponse(
+                        id=msg.id,
+                        conversation_id=msg.conversation_id,
+                        sender_id=msg.sender_id,
+                        sender_name=sender.username,
+                        text_original=msg.text_original,
+                        text_language=msg.text_language,
+                        text_translated=result,  # The translated text
+                        translation_status="success",
+                        translation_error=None,
+                        created_at=msg.created_at.isoformat(),
+                    )
+                )
+            else:
+                # Translation failed; return original + error
+                # result is the error detail (for logging); we send generic message to user
+                _log_audit(
+                    db,
+                    user_id=None,
+                    action="translation_request",
+                    resource_type="message",
+                    resource_id=msg.id,
+                    status="error",
+                    error_detail=result,  # Error detail from translation service
+                    metadata={
+                        "source_lang": msg.text_language,
+                        "target_lang": read_language,
+                    },
+                )
+                responses.append(
+                    MessageResponse(
