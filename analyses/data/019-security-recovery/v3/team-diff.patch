+    auth_with_lenient_limits.login(
+        email="alice@example.com",
+        password="wrong",
+        source_ip="10.0.0.1",
+        user_agent="pytest",
+    )
+    
+    # Still not locked.
+    result = auth_with_lenient_limits.login(
+        email="alice@example.com",
+        password="wrong",
+        source_ip="10.0.0.1",
+        user_agent="pytest",
+    )
+    assert result.reason == "account_locked"
