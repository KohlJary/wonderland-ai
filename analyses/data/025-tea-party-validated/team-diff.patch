+"""Account deletion scenarios: cascade, atomicity, session invalidation.
+
+These tests are RED right now (no auth + deletion endpoints exist).
+They verify that account deletion is atomic, complete, and safe.
+This is the GDPR scenario.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+
+class TestAccountDeletionCascade:
+    """When a user deletes their account, all associated data must be
+    cascaded and sessions invalidated atomically. This is GDPR-critical.
+    """
+
+    def test_account_deletion_cascades_homepage(self, client):
+        """When user is deleted, their homepage is also deleted and inaccessible."""
+        pytest.skip("Requires auth + homepage + deletion endpoints")
+
+        # Register a user.
+        client.post(
+            "/api/register",
+            json={"email": "sam@example.com", "desired_username": "sam"},
+        )
+
+        # Log in to get a token.
+        login_resp = client.post(
+            "/api/login",
+            json={"email": "sam@example.com", "password": "password123"},
+        )
+        token = login_resp.json().get("token")
+        headers = {"Authorization": f"Bearer {token}"}
+
+        # Create a homepage.
+        homepage_resp = client.post(
+            "/api/user/me/homepage",
+            json={"raw_markdown": "# Sam's Page\n\nHello world."},
+            headers=headers,
+        )
+        assert homepage_resp.status_code in [200, 201]
+
+        # Verify the homepage exists (as public).
