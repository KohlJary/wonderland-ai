+
+        # Safe formatting should be present.
+        assert "<strong>" in rendered_html or "<b>" in rendered_html, (
+            f"Bold formatting lost: {rendered_html}"
+        )
+        assert "<em>" in rendered_html or "<i>" in rendered_html, (
