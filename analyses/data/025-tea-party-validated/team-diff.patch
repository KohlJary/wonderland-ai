+"""Basic user journey: signup → login → create homepage → visit.
+
+This is the smoke test. If this breaks, the whole app is broken.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+
+class TestBasicUserJourney:
+    """End-to-end happy path: a real user comes, signs up, publishes a page,
+    and their friend visits it.
+    """
+
+    def test_signup_login_create_homepage_visit(self, client):
+        """Complete happy path: registration → login → homepage creation → public view."""
+        # Step 1: Register with valid email + username.
+        register_resp = client.post(
+            "/api/register",
+            json={
+                "email": "jordan@gmail.com",
+                "desired_username": "jordan_music",
+            },
+        )
+        assert register_resp.status_code in [200, 201, 202], (
+            f"Registration failed: {register_resp.status_code} {register_resp.json()}"
+        )
+        register_body = register_resp.json()
+        assert "verification_token_sent" in register_body or "message" in register_body, (
+            f"Response should indicate email sent. Got: {register_body}"
+        )
+
+        # Step 2: Log in with email + password.
+        login_resp = client.post(
+            "/api/login",
+            json={
+                "email": "jordan@gmail.com",
+                "password": "password123",
+            },
+        )
+        assert login_resp.status_code in [200, 201], (
+            f"Login failed: {login_resp.status_code} {login_resp.json()}"
+        )
+        login_body = login_resp.json()
+        token = login_body.get("token")
+        assert token, f"Login response should include token. Got: {login_body}"
+
+        # Step 3: Create a homepage (authenticated).
+        headers = {"Authorization": f"Bearer {token}"}
+        markdown_content = """# Jordan
+
+I make music. Check out my [SoundCloud](https://soundcloud.com/jordan_music).
+
+**Latest tracks:**
+- Track 1
+- Track 2"""
+
+        homepage_resp = client.post(
+            "/api/user/me/homepage",
+            json={"raw_markdown": markdown_content},
+            headers=headers,
+        )
+        assert homepage_resp.status_code in [200, 201], (
+            f"Homepage creation failed: {homepage_resp.status_code} {homepage_resp.json()}"
+        )
+        homepage_body = homepage_resp.json()
+        assert "rendered_html" in homepage_body or "success" in homepage_body, (
+            f"Homepage response should include rendered HTML. Got: {homepage_body}"
+        )
+
+        # Step 4: Visit the published page (unauthenticated, as a friend would).
+        public_resp = client.get("/api/user/jordan_music")
+        assert public_resp.status_code == 200, (
+            f"Public page visit failed: {public_resp.status_code} {public_resp.json()}"
+        )
+        public_body = public_resp.json()
+        rendered_html = public_body.get("rendered_html", "")
+
+        # Step 5: Verify the page renders the Markdown correctly.
+        assert "Jordan" in rendered_html, "Page should contain the heading"
+        assert "music" in rendered_html.lower(), "Page should contain content"
+        assert "SoundCloud" in rendered_html, "Page should contain the link text"
+        assert "href=" in rendered_html and "soundcloud.com" in rendered_html, (
+            "Page should render the link with href"
+        )
+
+    def test_signup_email_validation(self, client):
+        """Invalid email format is rejected at registration."""
+        # Missing @ sign.
+        resp = client.post(
+            "/api/register",
+            json={
+                "email": "notanemail",
+                "desired_username": "someone",
+            },
+        )
+        assert resp.status_code >= 400, (
+            f"Invalid email should be rejected, got {resp.status_code}"
+        )
+
+        # Empty email.
+        resp = client.post(
+            "/api/register",
+            json={
+                "email": "",
+                "desired_username": "someone",
+            },
+        )
+        assert resp.status_code >= 400
+
+    def test_login_with_invalid_credentials_fails(self, client):
+        """Login with wrong email or password fails."""
+        # Register a user first.
+        client.post(
+            "/api/register",
+            json={
+                "email": "valid@example.com",
+                "desired_username": "validuser",
+            },
+        )
+
+        # Try to log in with non-existent email.
+        resp = client.post(
+            "/api/login",
+            json={
+                "email": "notregistered@example.com",
+                "password": "password123",
+            },
+        )
+        assert resp.status_code >= 400, (
+            f"Login with non-existent email should fail, got {resp.status_code}"
+        )
+
+        # Try to log in with wrong password.
+        resp = client.post(
+            "/api/login",
+            json={
+                "email": "valid@example.com",
+                "password": "wrongpassword",
+            },
+        )
+        assert resp.status_code >= 400, (
+            f"Login with wrong password should fail, got {resp.status_code}"
+        )
+
+    def test_unauthenticated_homepage_create_fails(self, client):
+        """Creating a homepage without a valid token fails."""
+        # Try to create a homepage without auth.
+        resp = client.post(
+            "/api/user/me/homepage",
+            json={"raw_markdown": "# My Page"},
+        )
+        assert resp.status_code in [401, 403], (
+            f"Unauthenticated homepage create should fail, got {resp.status_code}"
+        )
+
+        # Try with invalid token.
+        resp = client.post(
+            "/api/user/me/homepage",
+            json={"raw_markdown": "# My Page"},
+            headers={"Authorization": "Bearer invalid_token"},
+        )
+        assert resp.status_code in [401, 403], (
+            f"Invalid token should fail, got {resp.status_code}"
+        )
+
+    def test_visiting_nonexistent_user_returns_404(self, client):
+        """Visiting /api/user/nonexistent returns 404."""
+        resp = client.get("/api/user/nonexistent")
+        assert resp.status_code == 404, (
+            f"Nonexistent user should return 404, got {resp.status_code}"
+        )
+
+    def test_homepage_markdown_is_case_sensitive(self, client):
+        """Markdown formatting is case-sensitive (e.g., [text](url) but not [TEXT](url))."""
+        # Register and log in.
+        client.post(
+            "/api/register",
+            json={
+                "email": "casetest@example.com",
+                "desired_username": "casetest",
+            },
+        )
+        login_resp = client.post(
+            "/api/login",
+            json={
+                "email": "casetest@example.com",
+                "password": "password123",
+            },
+        )
+        token = login_resp.json().get("token")
+        headers = {"Authorization": f"Bearer {token}"}
+
+        # Create homepage with proper Markdown.
+        markdown = """**Bold text** and [a link](https://example.com)"""
+
+        resp = client.post(
+            "/api/user/me/homepage",
+            json={"raw_markdown": markdown},
+            headers=headers,
+        )
+        assert resp.status_code in [200, 201]
+
+        # Visit the page.
+        public_resp = client.get("/api/user/casetest")
+        rendered = public_resp.json().get("rendered_html", "")
+
+        # Bold should be rendered.
+        assert "<strong>" in rendered or "<b>" in rendered, (
+            f"Bold formatting not rendered: {rendered}"
+        )
+
+        # Link should be rendered.
+        assert "example.com" in rendered and "<a" in rendered, (
+            f"Link not rendered: {rendered}"
+        )
