+"""In-memory session management for tokens.
+
+In v1, we use an in-memory dict to track which token belongs to which user.
+This is lost on server restart (acceptable for testing), but allows proper
+multi-user test scenarios.
+
+In production, use a session table in the database with expiry, refresh logic, etc.
+"""
+
+from __future__ import annotations
+
+# Global token → user_id mapping (v1 only; use DB in production)
+_token_store: dict[str, int] = {}
+
+
+def register_token(token: str, user_id: int) -> None:
+    """Associate a token with a user ID."""
+    _token_store[token] = user_id
+
+
+def get_user_id_from_token(token: str) -> int | None:
+    """Look up the user ID for a token, or None if invalid."""
+    return _token_store.get(token)
+
+
+def invalidate_token(token: str) -> None:
+    """Revoke a token."""
+    _token_store.pop(token, None)
