+"""Markdown parsing and sanitization."""
+
+from __future__ import annotations
+
+import re
+from html import escape
+
+
+def sanitize_html(html: str) -> str:
+    """
+    Basic HTML sanitization to prevent XSS.
+    Removes dangerous attributes and tags.
+    """
+    # Remove script tags and content
+    html = re.sub(r"<script[^>]*>.*?</script>", "", html, flags=re.DOTALL | re.IGNORECASE)
+
+    # Remove event handlers (onclick, onerror, onload, etc.)
+    html = re.sub(r'\s*on\w+\s*=\s*["\']?[^"\'>\s]+["\']?', "", html, flags=re.IGNORECASE)
+
+    # Remove javascript: URLs
+    html = re.sub(r'href\s*=\s*["\']?javascript:[^"\'>\s]*["\']?', "", html, flags=re.IGNORECASE)
+    html = re.sub(r'src\s*=\s*["\']?javascript:[^"\'>\s]*["\']?', "", html, flags=re.IGNORECASE)
+
+    # Remove dangerous tags entirely
+    dangerous_tags = ["script", "iframe", "object", "embed"]
+    for tag in dangerous_tags:
+        html = re.sub(rf"<{tag}[^>]*>.*?</{tag}>", "", html, flags=re.DOTALL | re.IGNORECASE)
+        html = re.sub(rf"<{tag}[^>]*/?>", "", html, flags=re.IGNORECASE)
+
+    return html
+
+
+def render_markdown(markdown_text: str) -> str:
+    """
+    Simple markdown renderer using regex.
+    Converts basic markdown to HTML and sanitizes.
+    
+    Supports:
+    - # Heading 1, ## Heading 2, etc.
+    - **bold** and *italic*
+    - [link](url)
+    - - List items
+    - > Blockquotes
+    - Line breaks preserved
+    """
+    if not markdown_text:
+        return ""
+
+    # First, process markdown syntax that shouldn't be escaped.
+    # We'll protect it by using placeholders.
+    html = markdown_text
+    
+    # Headings (must be at line start) - process before escaping
+    html = re.sub(r"^### (.*?)$", lambda m: f"<h3>{escape(m.group(1))}</h3>", html, flags=re.MULTILINE)
+    html = re.sub(r"^## (.*?)$", lambda m: f"<h2>{escape(m.group(1))}</h2>", html, flags=re.MULTILINE)
+    html = re.sub(r"^# (.*?)$", lambda m: f"<h1>{escape(m.group(1))}</h1>", html, flags=re.MULTILINE)
+
+    # Now escape the rest
+    # But we need to be careful not to escape the tags we just created.
+    # Simpler approach: process line by line after initial escaping
+    
+    lines = html.split("\n")
+    result = []
+    in_list = False
+    
+    for line in lines:
+        # Skip if it's already a heading tag (we processed it above)
+        if line.startswith("<h"):
+            result.append(line)
+            continue
+        
+        # Escape this line
+        line = escape(line)
+        
+        # **bold** and *italic*
+        line = re.sub(r"\*\*(.*?)\*\*", r"<strong>\1</strong>", line)
+        line = re.sub(r"\*(.*?)\*", r"<em>\1</em>", line)
+        
+        # [link](url) - after escaping, [ and ] are still [ and ]
+        line = re.sub(r"\[(.*?)\]\((https?://[^\)]+)\)", r'<a href="\2">\1</a>', line)
+        line = re.sub(r"\[(.*?)\]\((/[^\)]+)\)", r'<a href="\2">\1</a>', line)
+        
+        # Blockquotes (line starts with >)
+        if line.startswith("&gt; "):
+            line = f"<blockquote>{line[5:]}</blockquote>"
+        
+        # Lists (line starts with -)
+        if line.startswith("- "):
+            if not in_list:
+                result.append("<ul>")
+                in_list = True
+            result.append(f"<li>{line[2:]}</li>")
+        else:
+            if in_list:
+                result.append("</ul>")
+                in_list = False
+            result.append(line)
+    
+    if in_list:
+        result.append("</ul>")
+    
+    html = "\n".join(result)
+    
+    # Preserve newlines as <br> for display
+    html = html.replace("\n", "<br>\n")
+    
+    # Sanitize the result to remove any remaining XSS attempts
+    html = sanitize_html(html)
+    
+    return html
