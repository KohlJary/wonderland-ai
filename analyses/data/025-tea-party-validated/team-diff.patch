+"""Homepage edit scenarios: XSS, Markdown sanitization, size limits.
+
+These tests are RED right now (no homepage endpoints exist).
+They verify that the system correctly sanitizes Markdown and HTML
+to prevent XSS injection.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+
+class TestHomepageXSSSanitization:
+    """Markdown input can carry XSS payloads. Sanitization must strip them
+    before the rendered HTML is stored or served.
+    """
+
+    def test_homepage_xss_img_onerror_stripped(self, client):
+        """Malicious onerror handler in img tag is removed from rendered HTML."""
+        # Assume we can log in and edit a homepage.
+        # For now, this test will skip until login/auth is implemented.
+        pytest.skip("Requires auth + homepage endpoint implementation")
+
+        # Register and log in.
+        client.post(
+            "/api/register",
+            json={"email": "attacker@example.com", "desired_username": "attacker"},
+        )
+        login_resp = client.post(
+            "/api/login",
+            json={"email": "attacker@example.com", "password": "password123"},
+        )
+        token = login_resp.json().get("token")
+        headers = {"Authorization": f"Bearer {token}"}
+
+        # Malicious markdown with img onerror.
+        malicious_md = """# My Page
+
+<img src=x onerror="fetch('/steal-cookie')">
+
+Some text here."""
+
+        # POST to update homepage.
+        resp = client.post(
+            "/api/user/me/homepage",
+            json={"raw_markdown": malicious_md},
+            headers=headers,
+        )
+        assert resp.status_code in [200, 201], f"Homepage update failed: {resp.json()}"
+
+        # Fetch the rendered homepage (as unauthenticated visitor).
+        public_resp = client.get("/api/user/attacker")
+        assert public_resp.status_code == 200
+        rendered_html = public_resp.json().get("rendered_html", "")
+
+        # The onerror attribute should NOT appear in the rendered HTML.
+        assert "onerror" not in rendered_html.lower(), (
+            f"XSS: onerror attribute found in rendered_html: {rendered_html}"
+        )
+        # The event handler code should not appear either.
+        assert "fetch" not in rendered_html.lower() and "/steal-cookie" not in rendered_html, (
+            f"XSS: fetch/steal-cookie found in rendered_html: {rendered_html}"
+        )
+
+    def test_homepage_xss_javascript_url_stripped(self, client):
+        """javascript: URLs in links are neutralized."""
+        pytest.skip("Requires auth + homepage endpoint implementation")
+
+        # Register, log in, update homepage with malicious link.
+        client.post(
+            "/api/register",
+            json={"email": "attacker2@example.com", "desired_username": "attacker2"},
+        )
+        login_resp = client.post(
+            "/api/login",
+            json={"email": "attacker2@example.com", "password": "password123"},
+        )
+        token = login_resp.json().get("token")
+        headers = {"Authorization": f"Bearer {token}"}
+
+        malicious_md = """# Innocent-looking link
+
+[Click here](javascript:alert('XSS'))
+
+[Safe link](https://example.com)"""
+
+        resp = client.post(
+            "/api/user/me/homepage",
+            json={"raw_markdown": malicious_md},
+            headers=headers,
+        )
+        assert resp.status_code in [200, 201]
+
+        public_resp = client.get("/api/user/attacker2")
+        rendered_html = public_resp.json().get("rendered_html", "")
+
+        # javascript: should be removed or escaped.
+        assert "javascript:" not in rendered_html.lower(), (
+            f"XSS: javascript: URL found in rendered_html: {rendered_html}"
+        )
+
+        # Safe link should be preserved.
+        assert "example.com" in rendered_html, (
+            f"Safe link was stripped: {rendered_html}"
+        )
+
+    def test_homepage_xss_script_tag_stripped(self, client):
+        """<script> tags embedded in markdown are completely removed."""
+        pytest.skip("Requires auth + homepage endpoint implementation")
+
+        client.post(
+            "/api/register",
+            json={"email": "attacker3@example.com", "desired_username": "attacker3"},
