+        headers = {"Authorization": f"Bearer {token}"}
+
+        safe_md = """# My Page
+
+**Bold text** and *italic text* and [a safe link](https://example.com).
+
+- List item 1
+- List item 2
+
+> A blockquote
+"""
+
+        resp = client.post(
+            "/api/user/me/homepage",
