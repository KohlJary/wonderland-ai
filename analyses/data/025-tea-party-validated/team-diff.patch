+"""Discovery pagination scenarios: cursor stability, no duplicates, tie-breaking.
+
+These tests are RED right now (no discovery endpoint exists).
+They verify that cursor-based pagination is stable under concurrent updates.
+"""
+
+from __future__ import annotations
+
+import time
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+
+
+class TestDiscoveryPaginationStability:
+    """Cursor-based pagination with mutable sort keys (updated_at) must be stable.
+    Users should not see duplicates, missing items, or re-ordered items as they browse.
+    """
+
+    def test_pagination_no_duplicates_across_pages(self, client):
+        """No homepage appears twice when browsing multiple pages."""
+        pytest.skip("Requires auth + homepage + discovery endpoints")
+
+        # Create several homepages.
+        usernames = []
+        for i in range(15):
+            email = f"user{i}@example.com"
+            username = f"user{i}"
+            usernames.append(username)
+
+            # Register.
+            client.post(
+                "/api/register",
+                json={"email": email, "desired_username": username},
+            )
+
+            # Log in.
+            login_resp = client.post(
+                "/api/login",
+                json={"email": email, "password": "password123"},
+            )
+            token = login_resp.json().get("token")
+            headers = {"Authorization": f"Bearer {token}"}
+
+            # Create homepage.
+            client.post(
+                "/api/user/me/homepage",
+                json={"raw_markdown": f"# {username}\n\nContent for {username}."},
+                headers=headers,
+            )
+
+            # Small delay so updated_at is different.
+            time.sleep(0.01)
+
+        # Paginate through discovery with limit=5.
+        all_seen = []
+        cursor = None
+
+        for page_num in range(5):  # At most 5 pages to avoid infinite loop.
+            if cursor:
+                resp = client.get(f"/api/discover?limit=5&cursor={cursor}")
+            else:
+                resp = client.get("/api/discover?limit=5")
+
+            assert resp.status_code == 200, f"Discovery page {page_num} failed: {resp.json()}"
+            body = resp.json()
+
+            homepages = body.get("homepages", [])
+            for hp in homepages:
+                username = hp.get("username")
+                assert username not in all_seen, (
+                    f"Duplicate: {username} appeared on page {page_num} but was seen before"
+                )
+                all_seen.append(username)
+
+            cursor = body.get("next_cursor")
+            if not cursor:
+                break
+
+        # Should have seen all 15 homepages.
+        assert len(all_seen) == 15, (
+            f"Expected to see 15 homepages, saw {len(all_seen)}: {all_seen}"
+        )
+
+    def test_pagination_ordering_consistent_across_pages(self, client):
