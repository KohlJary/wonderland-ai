+"""Homepage endpoints: create/edit, view by username, discovery."""
+
+from __future__ import annotations
+
+from typing import Optional
+
+from fastapi import APIRouter, Depends, HTTPException, Header
+from pydantic import BaseModel, Field
+from sqlalchemy.orm import Session
+
+from src.backend.db import get_db
+from src.backend.models import User, Homepage
+from src.backend.markdown import render_markdown
+from src.backend.session import get_user_id_from_token
+
+router = APIRouter()
+
+
+class HomepageCreateRequest(BaseModel):
+    raw_markdown: str = Field(max_length=100000)
+
+
+class HomepageCreateResponse(BaseModel):
+    success: bool = True
+    rendered_html: str
+    updated_at: str
+
+
+class HomepagePublicResponse(BaseModel):
+    username: str
+    rendered_html: str
+    updated_at: str
+
+
+def get_user_from_authorization(authorization: Optional[str], db: Session) -> User:
+    """Extract and validate user from Authorization header.
+    
+    Expects: Authorization: Bearer <token>
+    """
+    if not authorization or not authorization.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Missing or invalid authorization header")
+
+    token = authorization[7:]  # Remove "Bearer "
+    
+    user_id = get_user_id_from_token(token)
+    if user_id is None:
+        raise HTTPException(status_code=401, detail="Invalid token")
+    
+    user = db.query(User).filter(User.id == user_id).first()
+    
+    if not user:
+        raise HTTPException(status_code=401, detail="User not found")
+    
+    return user
+
+
+@router.post("/user/me/homepage")
+def create_or_update_homepage(
+    payload: HomepageCreateRequest,
+    authorization: Optional[str] = Header(None),
+    db: Session = Depends(get_db),
+) -> HomepageCreateResponse:
+    """Create or update user's homepage (authenticated).
+    
+    Auth token expected in Authorization header as "Bearer <token>".
+    """
+    # Validate auth
+    user = get_user_from_authorization(authorization, db)
+    
+    # Render markdown to HTML (includes sanitization)
+    rendered_html = render_markdown(payload.raw_markdown)
+
+    # Find or create homepage
+    homepage = db.query(Homepage).filter(Homepage.user_id == user.id).first()
+    if homepage:
+        homepage.raw_markdown = payload.raw_markdown
+        homepage.rendered_html = rendered_html
+    else:
+        homepage = Homepage(
+            user_id=user.id,
+            raw_markdown=payload.raw_markdown,
+            rendered_html=rendered_html,
+        )
+        db.add(homepage)
+
+    db.commit()
+    db.refresh(homepage)
+
+    return HomepageCreateResponse(
+        success=True,
+        rendered_html=homepage.rendered_html,
+        updated_at=homepage.updated_at.isoformat(),
+    )
+
+
+@router.get("/user/{username}")
+def get_homepage_by_username(
+    username: str,
+    db: Session = Depends(get_db),
+) -> HomepagePublicResponse:
+    """Get a user's homepage by username (public, no auth required)."""
+    # Find user by username
+    user = db.query(User).filter(User.username == username).first()
+    if not user:
+        raise HTTPException(status_code=404, detail="User not found")
+
+    # Find their homepage
+    homepage = db.query(Homepage).filter(Homepage.user_id == user.id).first()
+    if not homepage:
+        raise HTTPException(status_code=404, detail="Homepage not found")
+
+    return HomepagePublicResponse(
+        username=user.username,
+        rendered_html=homepage.rendered_html,
+        updated_at=homepage.updated_at.isoformat(),
+    )
