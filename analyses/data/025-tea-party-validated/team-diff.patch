+"""Registration scenarios: concurrent signup, username uniqueness, validation.
+
+These tests are RED right now (no registration endpoints exist).
+They encode the contract for what the registration seam must do.
+"""
+
+from __future__ import annotations
+
+import concurrent.futures
+import time
+
+import pytest
+
+
+class TestRegistrationDuplicateUsernameRace:
+    """Two users signing up with the same username simultaneously.
+    
+    This scenario reveals whether the system maintains username uniqueness
+    as an invariant under concurrent load. SQLite serializes by default,
+    so this passes locally; PostgreSQL without proper locking will fail.
+    """
+
+    def test_concurrent_signup_same_username_exactly_one_succeeds(self, client):
+        """When two registrations for the same username happen at once,
+        exactly one should succeed (or both should fail with a clear error).
+        No silent data corruption.
+        """
+        shared_username = "jordan_musician_001"
+        email1 = "jordan1@example.com"
+        email2 = "jordan2@example.com"
+
+        results = []
+
+        def register(email):
+            """Attempt a registration and capture the response."""
+            try:
+                resp = client.post(
+                    "/api/register",
+                    json={"email": email, "desired_username": shared_username},
+                )
+                results.append(
+                    {
+                        "email": email,
+                        "status": resp.status_code,
+                        "body": resp.json(),
+                    }
+                )
+            except Exception as e:
+                results.append({"email": email, "error": str(e)})
+
+        # Fire both requests as close to simultaneously as possible.
+        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
+            futures = [
+                executor.submit(register, email1),
+                executor.submit(register, email2),
+            ]
+            concurrent.futures.wait(futures)
+
+        # At least one response should be in results.
+        assert len(results) >= 1, "No registration responses captured"
+
+        # Count successes (2xx status).
+        successes = [r for r in results if r.get("status", 0) < 300]
+        failures = [r for r in results if r.get("status", 0) >= 300]
+
+        # Case 1: One succeeds, one fails with conflict/validation.
+        if len(successes) == 1:
+            assert len(failures) == 1, "Expected one failure when one succeeds"
+            failure = failures[0]["body"]
+            # Failure should indicate username is taken and offer alternatives.
+            assert (
+                failure.get("error") in ["username_taken", "conflict"]
+                or "already" in failure.get("message", "").lower()
+            ), f"Failure message should indicate username taken, got {failure}"
+            if "suggested_usernames" in failure:
+                assert isinstance(failure["suggested_usernames"], list)
+                assert len(failure["suggested_usernames"]) > 0
+
+        # Case 2: Both fail (pessimistic locking, or DB enforced uniqueness fast).
+        elif len(successes) == 0:
+            # Both failed. Verify they both got an error, not silent corruption.
+            assert len(failures) == 2
+            # At least one should mention username conflict.
+            assert any(
+                "username" in f.get("body", {}).get("error", "").lower()
+                for f in failures
+            )
+
+        else:
+            pytest.fail(
+                f"Expected at most 1 success, got {len(successes)}. "
+                f"This indicates silent data corruption or race condition."
+            )
+
+    def test_registration_username_taken_returns_suggested_alternatives(self, client):
+        """When a desired username is already claimed, return suggestions.
+        
+        This is the happy path for the failure: user gets helpful alternatives
+        without needing to retry manually.
+        """
+        # First registration succeeds.
+        resp1 = client.post(
+            "/api/register",
+            json={"email": "first@example.com", "desired_username": "alex"},
+        )
+        assert resp1.status_code in [200, 201], f"First registration failed: {resp1.json()}"
+
+        # Second registration with same username fails but helpfully.
+        resp2 = client.post(
+            "/api/register",
+            json={"email": "second@example.com", "desired_username": "alex"},
+        )
+        assert resp2.status_code >= 300, f"Second registration should fail, got {resp2.status_code}"
+
+        body = resp2.json()
+        assert "suggested_usernames" in body or "alternatives" in body, (
+            f"When username is taken, return suggestions. Got: {body}"
+        )
+
+        # Suggestions should be an array of strings, all available.
+        suggestions = body.get("suggested_usernames") or body.get("alternatives")
+        assert isinstance(suggestions, list), f"Suggestions should be a list, got {type(suggestions)}"
+        assert len(suggestions) > 0, "At least one alternative should be suggested"
+        assert all(
+            isinstance(s, str) for s in suggestions
+        ), "All suggestions should be strings"
+
+    def test_registration_successful_returns_expected_shape(self, client):
+        """Happy path: registration succeeds and returns the expected shape.
+        
+        Sets up context for subsequent tests about login, homepage, etc.
+        """
+        email = "priya@example.com"
+        username = "priya_writes"
+
+        resp = client.post(
+            "/api/register",
+            json={"email": email, "desired_username": username},
+        )
+
+        # Registration should return 200, 201, or 202 (pending verification).
+        # Contract notes don't specify, but 200 is common for "sent verification email".
+        assert resp.status_code in [200, 201, 202], (
+            f"Registration POST should return success code, got {resp.status_code}: {resp.json()}"
+        )
+
+        body = resp.json()
+
+        # Expected fields per contract note.
+        assert "verification_token_sent" in body or "message" in body, (
+            f"Response should indicate verification email sent. Got: {body}"
+        )
+
+        # User should now be able to log in (once verified, or immediately if no verification).
+        # This is tested elsewhere; here we just confirm the response shape.
