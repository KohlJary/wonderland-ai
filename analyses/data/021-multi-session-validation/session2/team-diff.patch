@@ -204,3 +217,44 @@ class Message(Base):
             "updated_at": self.updated_at.isoformat() if self.updated_at else None,
             **({"sender_name": sender_name} if include_sender_name and sender_name else {}),
         }
+
+
+class Block(Base):
+    """User blocking with unidirectional control.
+    
+    Invariants:
+    - blocker_id != blocked_id (user cannot block themselves)
+    - (blocker_id, blocked_id) is unique (per-pair uniqueness; prevents duplicate blocks)
+    - blocker_id and blocked_id are valid User references (ForeignKey)
+    - created_at is immutable; tracking when the block was created
+    - Only the blocker can create or delete a Block; the blocked party cannot modify it
+    
+    Semantics:
+    - When user A blocks user B, B cannot send messages to conversations with A
+    - When user A lists messages in a conversation, messages from users who blocked A are filtered out
+    - Hard-delete on User account deletion (via cascade on delete of associated user)
+    """
+
+    __tablename__ = "blocks"
+
+    id = Column(UUID(as_uuid=True), primary_key=True, default=uuid4)
+    blocker_id = Column(UUID(as_uuid=True), ForeignKey("users.id"), nullable=False, index=True)
+    blocked_id = Column(UUID(as_uuid=True), ForeignKey("users.id"), nullable=False, index=True)
+    created_at = Column(DateTime(timezone=True), nullable=False, server_default=func.now())
+
+    __table_args__ = (
+        UniqueConstraint("blocker_id", "blocked_id", name="uq_block_pair"),
+    )
+
+    # Relationships
+    blocker = relationship("User", foreign_keys=[blocker_id], back_populates="blocks_as_blocker")
+    blocked = relationship("User", foreign_keys=[blocked_id], back_populates="blocks_as_blocked")
+
+    def to_dict(self) -> dict:
+        """Serialize to JSON."""
+        return {
+            "block_id": str(self.id),
+            "blocker_id": str(self.blocker_id),
+            "blocked_id": str(self.blocked_id),
+            "created_at": self.created_at.isoformat() if self.created_at else None,
+        }
