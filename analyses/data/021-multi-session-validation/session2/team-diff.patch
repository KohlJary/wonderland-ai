+"""User blocking endpoints: POST /api/blocks/{user_id} (create), GET /api/blocks (list), DELETE /api/blocks/{user_id} (unblock).
+
+Per ADR: blocks are unidirectional, enforced at message send + list, soft blocking (no 404 exposure).
+"""
+
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from pydantic import BaseModel
+from sqlalchemy.orm import Session
+
+from src.backend.api.auth import get_current_user
+from src.backend.db import get_db
+from src.backend.models import Block, User
+
+router = APIRouter(prefix="/blocks", tags=["blocks"])
+
+
+class BlockResponse(BaseModel):
+    """Response for block operations."""
+
+    block_id: str
+    blocker_id: str
+    blocked_id: str
+    created_at: str
+
+    class Config:
+        from_attributes = True
+
+
+@router.post("/{blocked_user_id}", response_model=BlockResponse, status_code=status.HTTP_201_CREATED)
+def create_block(
+    blocked_user_id: str,
+    authorization: str | None = None,
+    db: Session = Depends(get_db),
+) -> BlockResponse:
+    """Create a block: the authenticated user blocks another user.
+    
+    Per ADR: blocking is unidirectional (only blocker can unblock).
+    Blocked user cannot send messages to conversations with the blocker.
+    
+    **Invariants enforced:**
+    - blocker_id != blocked_id (cannot block yourself)
+    - (blocker_id, blocked_id) unique constraint (prevent duplicate blocks)
+    - both users must exist
+    """
+    blocker = get_current_user(authorization=authorization, db=db)
+
+    # Validate that blocked_user exists
+    blocked_user = db.query(User).filter(User.id == blocked_user_id).first()
+    if not blocked_user:
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="User to block not found")
+
+    # Cannot block yourself
+    if str(blocker.id) == blocked_user_id:
+        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="Cannot block yourself")
+
+    # Check if already blocked (idempotent: return 200 if already blocked)
+    existing = db.query(Block).filter(
+        Block.blocker_id == blocker.id,
+        Block.blocked_id == blocked_user_id,
+    ).first()
+
+    if existing:
+        return BlockResponse(
+            block_id=str(existing.id),
+            blocker_id=str(existing.blocker_id),
+            blocked_id=str(existing.blocked_id),
+            created_at=existing.created_at.isoformat() if existing.created_at else None,
+        )
+
+    # Create block
+    block = Block(blocker_id=blocker.id, blocked_id=blocked_user_id)
+    db.add(block)
+    db.commit()
+    db.refresh(block)
+
+    return BlockResponse(
+        block_id=str(block.id),
+        blocker_id=str(block.blocker_id),
+        blocked_id=str(block.blocked_id),
+        created_at=block.created_at.isoformat() if block.created_at else None,
+    )
+
+
+@router.get("", response_model=list[BlockResponse])
+def list_blocks(
+    authorization: str | None = None,
+    db: Session = Depends(get_db),
+) -> list[BlockResponse]:
+    """List all users blocked by the authenticated user.
+    
+    Returns the blocks created by the current user (where they are the blocker).
+    """
+    blocker = get_current_user(authorization=authorization, db=db)
+
+    blocks = db.query(Block).filter(Block.blocker_id == blocker.id).all()
+
+    return [
+        BlockResponse(
+            block_id=str(b.id),
+            blocker_id=str(b.blocker_id),
+            blocked_id=str(b.blocked_id),
+            created_at=b.created_at.isoformat() if b.created_at else None,
+        )
+        for b in blocks
+    ]
+
+
+@router.delete("/{blocked_user_id}", status_code=status.HTTP_204_NO_CONTENT)
+def unblock(
+    blocked_user_id: str,
+    authorization: str | None = None,
+    db: Session = Depends(get_db),
+) -> None:
+    """Unblock a user: the authenticated user removes a block.
+    
+    Per ADR: unblocking is unidirectional (only blocker can unblock).
+    Idempotent: unblocking a user who is not blocked returns 204 OK.
+    """
+    blocker = get_current_user(authorization=authorization, db=db)
+
+    # Find the block
+    block = db.query(Block).filter(
+        Block.blocker_id == blocker.id,
+        Block.blocked_id == blocked_user_id,
+    ).first()
+
+    if block:
+        db.delete(block)
+        db.commit()
