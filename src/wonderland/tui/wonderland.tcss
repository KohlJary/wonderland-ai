/* Wonderland TUI stylesheet.
 *
 * Uses Textual design tokens ($primary, $secondary, $accent, $surface,
 * $panel, $boost, $foreground, $background) so a theme switch via
 * the `t` binding propagates without the stylesheet caring. The
 * concrete palettes live in src/wonderland/tui/themes.py. */

Screen {
    layers: base overlay;
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $accent;
}

Footer {
    background: $boost;
    color: $primary;
}

Footer > .footer--key {
    color: $accent;
    background: $boost;
}

Footer > .footer--description {
    color: $foreground;
}

#library-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#summary-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $foreground;
    height: auto;
}

#meetings-label,
#agents-label,
#utterances-label {
    padding: 1 2 0 2;
    margin-top: 1;
    color: $primary;
}

DataTable {
    margin: 0 2 1 2;
    background: $background;
    color: $foreground;
}

DataTable > .datatable--header {
    background: $panel;
    color: $accent;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $background;
}

DataTable > .datatable--hover {
    background: $surface;
}

#preview-label {
    padding: 1 2 0 2;
    margin-top: 1;
    color: $primary;
}

#preview-scroll {
    height: 1fr;
    margin: 0 2 1 2;
    border: round $panel;
    padding: 1;
}

#preview-body {
    color: $foreground;
}

/* In meeting detail and artifact browser: give the table a fixed-ish
 * height so the preview pane below has room to breathe. */
MeetingDetailScreen #utterance-table,
ArtifactBrowserScreen #artifact-table {
    height: 50%;
}

/* Live-watch screen — lazygit-style multi-pane layout (T48):
 * Meetings on the left, Transcript + Artifacts stacked on the right.
 * Tab cycles focus; meeting selection drives panel filtering. */
#live-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#live-main-row {
    height: 1fr;
}

LiveRunScreen #left-pane {
    width: 38%;
    height: 1fr;
    margin: 0 1 0 0;
}

LiveRunScreen #right-pane {
    width: 1fr;
    height: 1fr;
}

LiveRunScreen #live-meetings-table {
    height: 1fr;
    margin: 0 0 1 2;
}

#transcript-label,
#transcript-body-label,
#artifacts-label {
    padding: 0 2;
    color: $primary;
    height: auto;
}

LiveRunScreen #transcript-table {
    height: 35%;
    margin: 0 2 0 0;
    border: round $panel;
}

LiveRunScreen #transcript-body-scroll {
    height: 30%;
    margin: 0 2 0 0;
    border: round $panel;
    padding: 1;
}

LiveRunScreen #transcript-body {
    color: $foreground;
}

LiveRunScreen #live-artifacts-table {
    height: 35%;
    margin: 0 2 1 0;
    border: round $panel;
}

#live-status {
    padding: 0 2;
    margin: 0 2 1 2;
    background: $boost;
    color: $foreground;
    height: auto;
}

/* Cast view */
#cast-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#member-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $foreground;
    height: auto;
}

#member-summary {
    padding: 1 2;
    margin: 0 2 1 2;
    color: $foreground;
    border: round $panel;
    height: auto;
}

#constitution-label {
    padding: 0 2;
    margin-top: 1;
    color: $primary;
}

#constitution-scroll {
    height: 1fr;
    margin: 0 2 1 2;
    border: round $panel;
    padding: 1;
}
