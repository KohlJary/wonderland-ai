/* Wonderland TUI stylesheet.
 *
 * Uses Textual design tokens ($primary, $secondary, $accent, $surface,
 * $panel, $boost, $foreground, $background) so a theme switch via
 * the `t` binding propagates without the stylesheet caring. The
 * concrete palettes live in src/wonderland/tui/themes.py. */

Screen {
    layers: base overlay;
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $accent;
}

Footer {
    background: $boost;
    color: $primary;
}

Footer > .footer--key {
    color: $accent;
    background: $boost;
}

Footer > .footer--description {
    color: $foreground;
}

#home-title {
    padding: 1 2;
    background: $surface;
    color: $accent;
    height: auto;
    text-align: center;
}

#home-actions {
    height: auto;
    padding: 0 2;
    margin: 1 0 1 0;
    align: center middle;
}

#home-actions Button {
    margin: 0 1;
    min-width: 20;
}

#library-header {
    padding: 0 2;
    margin: 1 0 1 0;
    color: $primary;
    height: auto;
}

#summary-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $foreground;
    height: auto;
}

#meetings-label,
#agents-label,
#utterances-label {
    padding: 1 2 0 2;
    margin-top: 1;
    color: $primary;
}

DataTable {
    margin: 0 2 1 2;
    background: $background;
    color: $foreground;
}

DataTable > .datatable--header {
    background: $panel;
    color: $accent;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $background;
}

DataTable > .datatable--hover {
    background: $surface;
}

#preview-label {
    padding: 1 2 0 2;
    margin-top: 1;
    color: $primary;
}

#preview-scroll {
    height: 1fr;
    margin: 0 2 1 2;
    border: round $panel;
    padding: 1;
}

#preview-body {
    color: $foreground;
}

/* In meeting detail and artifact browser: give the table a fixed-ish
 * height so the preview pane below has room to breathe. */
MeetingDetailScreen #utterance-table,
ArtifactBrowserScreen #artifact-table {
    height: 50%;
}

/* Live-watch screen — lazygit-style multi-pane layout (T48):
 * Meetings on the left, Transcript + Artifacts stacked on the right.
 * Tab cycles focus; meeting selection drives panel filtering. */
#live-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#live-main-row {
    height: 1fr;
}

LiveRunScreen #left-pane {
    width: 38%;
    height: 1fr;
    margin: 0 1 0 0;
}

LiveRunScreen #right-pane {
    width: 1fr;
    height: 1fr;
}

LiveRunScreen #meetings-chase {
    margin: 0 2 0 2;
    height: 1;
}

LiveRunScreen #live-meetings-table {
    height: 1fr;
    margin: 0 0 1 2;
}

#transcript-label,
#transcript-body-label,
#artifacts-label {
    padding: 0 2;
    color: $primary;
    height: auto;
}

/* Right-pane vertical stack: 4 tables (transcript, body, artifacts,
 * phase events) share the available space via 1fr each. Using
 * percentages would overflow because of the 4 auto-height labels;
 * flex sizing lets the labels eat their natural lines first and the
 * tables divide what's left. */
LiveRunScreen #transcript-table {
    height: 1fr;
    margin: 0 2 0 0;
    border: round $panel;
}

LiveRunScreen #transcript-body-scroll {
    height: 1fr;
    margin: 0 2 0 0;
    border: round $panel;
    padding: 1;
}

LiveRunScreen #transcript-body {
    color: $foreground;
}

LiveRunScreen #live-artifacts-table {
    height: 1fr;
    margin: 0 2 0 0;
    border: round $panel;
}

LiveRunScreen #live-phase-events-table {
    height: 1fr;
    margin: 0 2 1 0;
    border: round $panel;
}

#live-status {
    padding: 0 2;
    margin: 0 2 1 2;
    background: $boost;
    color: $foreground;
    height: auto;
}

/* New-run screen — preset picker + directive composer + config row */
#new-run-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#new-run-main {
    height: 1fr;
}

NewRunScreen #preset-pane {
    width: 38%;
    height: 1fr;
    margin: 0 1 0 0;
}

NewRunScreen #composer-pane {
    width: 1fr;
    height: 1fr;
}

NewRunScreen #preset-table {
    height: 1fr;
    margin: 0 0 1 2;
}

#preset-label,
#composer-label,
#description-label,
#config-label {
    padding: 0 2;
    color: $primary;
    height: auto;
}

NewRunScreen #directive-composer {
    height: 60%;
    margin: 0 2 0 0;
    border: round $panel;
}

NewRunScreen #description-composer {
    height: 40%;
    margin: 0 2 1 0;
    border: round $panel;
}

#config-row,
#project-row,
#save-row {
    height: auto;
    padding: 0 2;
    margin: 0 0 1 0;
}

#config-row Label,
#project-row Label,
#save-row Label {
    padding: 1 1 0 0;
    color: $primary;
    width: auto;
}

#config-row Input,
#project-row Input,
#save-row Input,
#config-row Select {
    width: 1fr;
    margin: 0 1 0 0;
}

#workflow-select {
    width: 30;
}

#budget-input {
    width: 12;
}

#save-checkbox {
    width: auto;
    margin: 0 2 0 0;
}

#save-name-input {
    width: 1fr;
}

#action-row {
    height: auto;
    padding: 0 2;
    margin: 1 0 1 0;
    align: center middle;
}

#action-row Button {
    margin: 0 1;
}

#go-button {
    min-width: 16;
}

#cancel-button {
    min-width: 16;
}

/* Analyses view — single-page lazygit shape: list at top,
 * markdown viewer below filtered by cursor selection. */
#analyses-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

AnalysesScreen #analyses-table {
    height: 35%;
    margin: 0 2 0 2;
}

#analysis-meta {
    padding: 0 2;
    margin: 1 2 0 2;
    color: $foreground;
    height: auto;
}

#analysis-scroll {
    height: 1fr;
    margin: 0 2 1 2;
    border: round $panel;
    padding: 1;
}

/* Skeleton picker (T71 / P8.6) — pre-launch step for bare project
 * roots. Lazygit-shape: list left, preview right, action row at
 * the bottom. */
#skeleton-picker-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}
#skeleton-picker-blurb {
    padding: 0 2;
    margin-bottom: 1;
    color: $foreground;
    height: auto;
}
#skeleton-picker-row {
    height: 1fr;
}
SkeletonPickerScreen #skeleton-list-pane {
    width: 38%;
    height: 1fr;
    margin: 0 1 0 0;
}
SkeletonPickerScreen #skeleton-preview-pane {
    width: 1fr;
    height: 1fr;
}
SkeletonPickerScreen #skeleton-list-table {
    height: 1fr;
    margin: 0 0 1 2;
}
SkeletonPickerScreen #skeleton-preview-scroll {
    height: 1fr;
    margin: 0 2 1 0;
    border: round $panel;
    padding: 1;
}
#skeleton-list-label,
#skeleton-preview-label {
    padding: 0 2;
    color: $primary;
    height: auto;
}
#skeleton-action-row {
    height: auto;
    padding: 0 2;
    margin: 0 0 1 0;
    align: center middle;
}
#skeleton-action-row Button {
    margin: 0 1;
    min-width: 22;
}

/* Settings screen — user-level config form */
#settings-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#settings-status {
    padding: 0 2;
    margin: 0 2 1 2;
    color: $foreground;
    height: auto;
}

#settings-api-key-label,
#settings-model-label {
    padding: 1 2 0 2;
    color: $primary;
    height: auto;
}

#settings-api-key-row,
#settings-model-row {
    height: auto;
    padding: 0 2;
    margin: 0 0 1 0;
}

#settings-api-key-row Label,
#settings-model-row Label {
    padding: 1 1 0 0;
    color: $primary;
    width: auto;
}

#settings-api-key-row Input,
#settings-model-row Input {
    width: 1fr;
    margin: 0 1 0 0;
}

#settings-actions {
    height: auto;
    padding: 0 2;
    margin: 1 0 1 0;
    align: center middle;
}

#settings-actions Button {
    margin: 0 1;
    min-width: 18;
}

/* Cast view — single-page lazygit-shape: list at top, bio +
 * constitution panes below filtered by cursor selection. */
#cast-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

CastBrowserScreen #cast-table {
    height: 30%;
    margin: 0 2 0 2;
}

#cast-member-header {
    padding: 1 2;
    margin: 1 2 1 2;
    background: $surface;
    color: $foreground;
    height: auto;
}

#cast-detail-row {
    height: 1fr;
}

CastBrowserScreen #cast-bio-pane {
    width: 50%;
    height: 1fr;
    margin: 0 1 1 2;
}

CastBrowserScreen #cast-constitution-pane {
    width: 1fr;
    height: 1fr;
    margin: 0 2 1 0;
}

#cast-bio-label,
#constitution-label {
    padding: 0 2;
    color: $primary;
    height: auto;
}

#cast-bio-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1;
}

#cast-bio {
    color: $foreground;
}

#constitution-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1;
}

/* ProjectLibraryScreen — TUI home (P11 T75). Three-column main row:
 * project list (2fr), actions menu (auto-width), detail pane (3fr).
 * Project-context buttons sit in their own bottom row, close to the
 * project they act on. */

#project-library-row {
    height: 1fr;
    padding: 0 2;
}

#project-list-pane {
    width: 2fr;
    height: 1fr;
    margin: 0 1 1 0;
}

#action-menu-pane {
    width: 24;
    height: 1fr;
    margin: 0 1 1 1;
}

#project-detail-pane {
    width: 3fr;
    height: 1fr;
    margin: 0 0 1 1;
}

#project-list-label,
#action-menu-label,
#project-detail-label {
    padding: 0 1;
    color: $primary;
    height: auto;
}

#project-table,
#action-table {
    height: 1fr;
    border: round $panel;
}

#project-detail-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1;
}

#project-detail {
    color: $foreground;
}

/* Project-context buttons sit inside #project-list-pane, directly
 * under the project DataTable — visually grouping the affordance
 * with the data it acts on. Full-width of the project column,
 * stacked vertically for prominence. */

#project-list-buttons {
    height: auto;
    margin: 1 0 0 0;
}

#project-list-buttons Button {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
}

/* NewProjectScreen — registration form (P11 T76). */

#new-project-root {
    height: 1fr;
    padding: 0 2;
}

#new-project-header {
    padding: 1 2;
    background: $surface;
    color: $accent;
    height: auto;
    text-align: center;
    margin-bottom: 1;
}

#new-project-form-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1 2;
}

#new-project-form Label {
    padding: 1 0 0 0;
    color: $primary;
    height: auto;
}

#new-project-form Input {
    margin: 0 0 0 0;
}

#new-project-form Static {
    color: $foreground;
    height: auto;
    padding: 0 0 0 1;
}

#name-help,
#path-status,
#workflow-help,
#skeleton-help,
#budget-help {
    height: auto;
    padding: 0 0 1 1;
}

#skeleton-apply-row {
    height: auto;
    padding: 0;
    margin: 0;
}

#new-project-action-row {
    height: auto;
    padding: 1 0;
    margin: 1 0 0 0;
    align: center middle;
}

#new-project-action-row Button {
    margin: 0 1;
    min-width: 18;
}

/* EditProjectScreen — registration form mirror (P11 T77). */

#edit-project-root {
    height: 1fr;
    padding: 0 2;
}

#edit-project-header {
    padding: 1 2;
    background: $surface;
    color: $accent;
    height: auto;
    text-align: center;
    margin-bottom: 1;
}

#edit-project-form-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1 2;
}

#edit-project-form Label {
    padding: 1 0 0 0;
    color: $primary;
    height: auto;
}

#edit-project-form Static {
    color: $foreground;
    height: auto;
    padding: 0 0 0 1;
}

#edit-identity-block {
    padding: 0 0 1 1;
    color: $foreground;
}

#edit-identity-help,
#edit-budget-help {
    padding: 0 0 1 1;
}

#edit-project-action-row {
    height: auto;
    padding: 1 0;
    margin: 1 0 0 0;
    align: center middle;
}

#edit-project-action-row Button {
    margin: 0 1;
    min-width: 18;
}

/* ProjectDashboardScreen — per-project tabs (P11 T79+T80+T83). */

#dashboard-root {
    height: 1fr;
    padding: 0 2;
}

#dashboard-header {
    padding: 1 2;
    background: $surface;
    color: $accent;
    height: auto;
    text-align: center;
    margin-bottom: 1;
}

#dashboard-actions {
    height: 5;
    padding: 1 2;
    margin: 0 0 1 0;
    align: left middle;
}

#dashboard-actions Button {
    margin: 0 1 0 0;
    min-width: 18;
}

/* Features primary surface — dominant content area on the dashboard
 * (per the P12 reshape: features are the operator's main attention
 * point, not a tab among equals). */

#features-row {
    height: 2fr;
    padding: 0 2;
}

#features-list-pane {
    width: 5fr;
    height: 1fr;
    margin: 0 1 1 0;
}

#features-detail-pane {
    width: 3fr;
    height: 1fr;
    margin: 0 0 1 1;
}

#features-list-label,
#features-detail-label {
    padding: 0 1;
    color: $primary;
    height: auto;
}

#features-filter-row {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
}

#features-filter-row Button {
    margin: 0 1 0 0;
    min-width: 12;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    border: none;
}

#features-filter-row Button.filter-active {
    background: $accent;
    color: $background;
}

#features-tree {
    height: 1fr;
    border: round $panel;
}

#features-detail-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1;
}

#features-detail {
    color: $foreground;
}

#feature-actions-row {
    height: auto;
    padding: 1 0;
    margin: 1 0 0 0;
    align: center middle;
}

#feature-actions-row Button {
    margin: 0 1;
    min-width: 12;
}

/* Drill-downs — investigation surfaces below the features section,
 * smaller real estate. Operator opens via 1/2/3/4 keybinds when
 * digging into "why did the team make this decision?" questions. */

#dashboard-drilldown-label {
    padding: 0 2;
    margin: 1 0 0 0;
    color: $primary;
    height: auto;
}

#dashboard-tabs {
    height: 1fr;
    margin: 0 0 0 0;
}

#runs-tab-row,
#artifacts-tab-row {
    height: 1fr;
}

#runs-list-pane,
#artifacts-list-pane {
    width: 2fr;
    height: 1fr;
    margin: 0 1 1 0;
}

#runs-detail-pane,
#artifacts-detail-pane {
    width: 3fr;
    height: 1fr;
    margin: 0 0 1 1;
}

#runs-list-label,
#runs-detail-label,
#artifacts-list-label,
#artifacts-detail-label {
    padding: 0 1;
    color: $primary;
    height: auto;
}

#runs-table,
#artifacts-table {
    height: 1fr;
    border: round $panel;
}

#runs-detail-scroll,
#artifacts-detail-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1;
}

#runs-detail,
#artifacts-detail {
    color: $foreground;
}

/* Files tab (T81): DirectoryTree left, content viewer right. */

#files-tab-row {
    height: 1fr;
}

#files-tree-pane {
    width: 2fr;
    height: 1fr;
    margin: 0 1 1 0;
}

#files-detail-pane {
    width: 3fr;
    height: 1fr;
    margin: 0 0 1 1;
}

#files-tree-label,
#files-detail-label {
    padding: 0 1;
    color: $primary;
    height: auto;
}

#files-tree {
    height: 1fr;
    border: round $panel;
}

#files-detail-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1;
}

#files-detail {
    color: $foreground;
}

/* Metrics tab (T82): scrollable plotext-rendered chart stack. */

#metrics-scroll {
    height: 1fr;
    margin: 0 0 1 0;
    padding: 1 2;
}

#metrics-content {
    color: $foreground;
}

/* VerifyRejectModal — operator's verify/reject decision dialog
 * (P12 T90). Lazygit-style centered modal with notes textarea. */

VerifyRejectModal {
    align: center middle;
}

#verify-modal-root {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#verify-modal-header {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    text-align: center;
}

#verify-modal-feature {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: $panel;
    border: round $panel;
}

#verify-modal-guidance {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    color: $foreground;
}

#verify-modal-notes-scroll {
    height: 12;
    border: round $panel;
    margin-bottom: 1;
}

#verify-modal-notes {
    height: auto;
    background: $background;
}

#verify-modal-actions {
    height: auto;
    padding: 1 0;
    align: center middle;
}

#verify-modal-actions Button {
    margin: 0 1;
    min-width: 24;
}

/* EmptyDirectiveConfirmModal — confirms launching with empty
 * directive (P12 follow-up; for tdd-implement and similar). */

EmptyDirectiveConfirmModal {
    align: center middle;
}

#empty-dir-modal-root {
    width: 70%;
    max-width: 80;
    height: auto;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#empty-dir-modal-header {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    text-align: center;
}

#empty-dir-modal-body {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    color: $foreground;
}

#empty-dir-modal-actions {
    height: auto;
    padding: 1 0;
    align: center middle;
}

#empty-dir-modal-actions Button {
    margin: 0 1;
    min-width: 28;
}

/* QuitConfirmModal — fingerslip-guard for the q binding. Same
 * centered layout as the other confirmation modals; sized smaller
 * because the body text is short. */

QuitConfirmModal {
    align: center middle;
}

#quit-modal-root {
    width: 60%;
    max-width: 60;
    height: auto;
    background: $surface;
    border: round $warning;
    padding: 1 2;
}

#quit-modal-header {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    text-align: center;
}

#quit-modal-body {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    color: $foreground;
}

#quit-modal-actions {
    height: auto;
    padding: 1 0;
    align: center middle;
}

#quit-modal-actions Button {
    margin: 0 1;
    min-width: 14;
}
