/* Wonderland TUI stylesheet.
 *
 * Uses Textual design tokens ($primary, $secondary, $accent, $surface,
 * $panel, $boost, $foreground, $background) so a theme switch via
 * the `t` binding propagates without the stylesheet caring. The
 * concrete palettes live in src/wonderland/tui/themes.py. */

Screen {
    layers: base overlay;
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $accent;
}

Footer {
    background: $boost;
    color: $primary;
}

Footer > .footer--key {
    color: $accent;
    background: $boost;
}

Footer > .footer--description {
    color: $foreground;
}

#home-title {
    padding: 1 2;
    background: $surface;
    color: $accent;
    height: auto;
    text-align: center;
}

#home-actions {
    height: auto;
    padding: 0 2;
    margin: 1 0 1 0;
    align: center middle;
}

#home-actions Button {
    margin: 0 1;
    min-width: 20;
}

#library-header {
    padding: 0 2;
    margin: 1 0 1 0;
    color: $primary;
    height: auto;
}

#summary-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $foreground;
    height: auto;
}

#meetings-label,
#agents-label,
#utterances-label {
    padding: 1 2 0 2;
    margin-top: 1;
    color: $primary;
}

DataTable {
    margin: 0 2 1 2;
    background: $background;
    color: $foreground;
}

DataTable > .datatable--header {
    background: $panel;
    color: $accent;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $background;
}

DataTable > .datatable--hover {
    background: $surface;
}

#preview-label {
    padding: 1 2 0 2;
    margin-top: 1;
    color: $primary;
}

#preview-scroll {
    height: 1fr;
    margin: 0 2 1 2;
    border: round $panel;
    padding: 1;
}

#preview-body {
    color: $foreground;
}

/* In meeting detail and artifact browser: give the table a fixed-ish
 * height so the preview pane below has room to breathe. */
MeetingDetailScreen #utterance-table,
ArtifactBrowserScreen #artifact-table {
    height: 50%;
}

/* Live-watch screen — lazygit-style multi-pane layout (T48):
 * Meetings on the left, Transcript + Artifacts stacked on the right.
 * Tab cycles focus; meeting selection drives panel filtering. */
#live-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#live-main-row {
    height: 1fr;
}

LiveRunScreen #left-pane {
    width: 38%;
    height: 1fr;
    margin: 0 1 0 0;
}

LiveRunScreen #right-pane {
    width: 1fr;
    height: 1fr;
}

LiveRunScreen #live-meetings-table {
    height: 1fr;
    margin: 0 0 1 2;
}

#transcript-label,
#transcript-body-label,
#artifacts-label {
    padding: 0 2;
    color: $primary;
    height: auto;
}

LiveRunScreen #transcript-table {
    height: 35%;
    margin: 0 2 0 0;
    border: round $panel;
}

LiveRunScreen #transcript-body-scroll {
    height: 30%;
    margin: 0 2 0 0;
    border: round $panel;
    padding: 1;
}

LiveRunScreen #transcript-body {
    color: $foreground;
}

LiveRunScreen #live-artifacts-table {
    height: 35%;
    margin: 0 2 1 0;
    border: round $panel;
}

#live-status {
    padding: 0 2;
    margin: 0 2 1 2;
    background: $boost;
    color: $foreground;
    height: auto;
}

/* New-run screen — preset picker + directive composer + config row */
#new-run-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#new-run-main {
    height: 1fr;
}

NewRunScreen #preset-pane {
    width: 38%;
    height: 1fr;
    margin: 0 1 0 0;
}

NewRunScreen #composer-pane {
    width: 1fr;
    height: 1fr;
}

NewRunScreen #preset-table {
    height: 1fr;
    margin: 0 0 1 2;
}

#preset-label,
#composer-label,
#description-label,
#config-label {
    padding: 0 2;
    color: $primary;
    height: auto;
}

NewRunScreen #directive-composer {
    height: 60%;
    margin: 0 2 0 0;
    border: round $panel;
}

NewRunScreen #description-composer {
    height: 40%;
    margin: 0 2 1 0;
    border: round $panel;
}

#config-row,
#project-row,
#save-row {
    height: auto;
    padding: 0 2;
    margin: 0 0 1 0;
}

#config-row Label,
#project-row Label,
#save-row Label {
    padding: 1 1 0 0;
    color: $primary;
    width: auto;
}

#config-row Input,
#project-row Input,
#save-row Input,
#config-row Select {
    width: 1fr;
    margin: 0 1 0 0;
}

#workflow-select {
    width: 30;
}

#budget-input {
    width: 12;
}

#save-checkbox {
    width: auto;
    margin: 0 2 0 0;
}

#save-name-input {
    width: 1fr;
}

#action-row {
    height: auto;
    padding: 0 2;
    margin: 1 0 1 0;
    align: center middle;
}

#action-row Button {
    margin: 0 1;
}

#go-button {
    min-width: 16;
}

#cancel-button {
    min-width: 16;
}

/* Analyses view — single-page lazygit shape: list at top,
 * markdown viewer below filtered by cursor selection. */
#analyses-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

AnalysesScreen #analyses-table {
    height: 35%;
    margin: 0 2 0 2;
}

#analysis-meta {
    padding: 0 2;
    margin: 1 2 0 2;
    color: $foreground;
    height: auto;
}

#analysis-scroll {
    height: 1fr;
    margin: 0 2 1 2;
    border: round $panel;
    padding: 1;
}

/* Settings screen — user-level config form */
#settings-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

#settings-status {
    padding: 0 2;
    margin: 0 2 1 2;
    color: $foreground;
    height: auto;
}

#settings-api-key-label,
#settings-model-label {
    padding: 1 2 0 2;
    color: $primary;
    height: auto;
}

#settings-api-key-row,
#settings-model-row {
    height: auto;
    padding: 0 2;
    margin: 0 0 1 0;
}

#settings-api-key-row Label,
#settings-model-row Label {
    padding: 1 1 0 0;
    color: $primary;
    width: auto;
}

#settings-api-key-row Input,
#settings-model-row Input {
    width: 1fr;
    margin: 0 1 0 0;
}

#settings-actions {
    height: auto;
    padding: 0 2;
    margin: 1 0 1 0;
    align: center middle;
}

#settings-actions Button {
    margin: 0 1;
    min-width: 18;
}

/* Cast view — single-page lazygit-shape: list at top, bio +
 * constitution panes below filtered by cursor selection. */
#cast-header {
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    color: $accent;
}

CastBrowserScreen #cast-table {
    height: 30%;
    margin: 0 2 0 2;
}

#cast-member-header {
    padding: 1 2;
    margin: 1 2 1 2;
    background: $surface;
    color: $foreground;
    height: auto;
}

#cast-detail-row {
    height: 1fr;
}

CastBrowserScreen #cast-bio-pane {
    width: 50%;
    height: 1fr;
    margin: 0 1 1 2;
}

CastBrowserScreen #cast-constitution-pane {
    width: 1fr;
    height: 1fr;
    margin: 0 2 1 0;
}

#cast-bio-label,
#constitution-label {
    padding: 0 2;
    color: $primary;
    height: auto;
}

#cast-bio-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1;
}

#cast-bio {
    color: $foreground;
}

#constitution-scroll {
    height: 1fr;
    border: round $panel;
    padding: 1;
}
